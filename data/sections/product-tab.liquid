<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>

{% style %}
.product-detail-tabs .tabs {
  margin: 20px;
  padding: 0;
  list-style: none;
  position: relative;
  border-bottom: 1px solid #ccc;
}
.product-detail-tabs .tabs li {
  padding: 1rem;
  margin-bottom: -2px;
  font-size: 1.6rem;
  letter-spacing: .1rem;
  line-height: calc(1 + .2 / var(--font-body-scale));
  text-transform: capitalize;
  cursor: pointer;
  display: inline-block;
  font-weight: var(--font-body-weight-semibold);
}
.product-detail-tabs .tabs .active-tab {
  border-bottom: 2px solid #000;
  color: rgba(var(--color-foreground), .8);
}
.product-detail-tabs .tabs-content {
  margin: 20px;
  padding: 0;
  list-style: none;
}
.product-detail-tabs .tabs-content li {
  display: none;
}
.product-detail-tabs .tabs-content li p {
  font-weight: var(--font-body-weight-semibold);
  text-transform: capitalize;
  margin: 0.8rem 0;
  font-size: 1.4rem;
}
@media screen and (max-width: 749px) {
  .product-detail-tabs .tabs,
  .product-detail-tabs .tabs-content {
    margin: 15px 0;
  }
}
{% endstyle %}
<div class="page-width">
  <div class="product-detail-tabs">
    {% assign blockcount = section.blocks | size %}
    {% if blockcount > 0 %}
      <ul class="tabs">
        {% for block in section.blocks %}
          <li class="{% if forloop.first %} active-tab{% endif %}">{{ block.settings.tab_title }}</li>
        {% endfor %}
      </ul>
      
      <ul class="tabs-content">
        {% for block in section.blocks %}
          <li>
            {{ block.settings.tab_description }}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

<script>
$(function () {
  var activeIndex = $('.active-tab').index(),
    $contentlis = $('.tabs-content li'),
    $tabslis = $('.tabs li');
  // Show content of active tab on loads
  $contentlis.eq(activeIndex).show();
  $('.tabs').on('click', 'li', function (e) {
    var $current = $(e.currentTarget),
        index = $current.index();
    $tabslis.removeClass('active-tab');
    $current.addClass('active-tab');
    $contentlis.hide().eq(index).show(); 
  });
});
</script>

{% schema %}
  {
    "name": "Product Tab",
    "class": "section",
    "tag": "section",
    "settings": [
    ],
    "blocks": [
      {
        "name": "Tab",
        "type": "Tab",
        "settings": [
          {
            "type": "text",
            "id": "tab_title",
            "label": "Title"
          },
          {
            "type": "richtext",
            "id": "tab_description",
            "label": "Description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Product tab"
      }
    ]
  }
{% endschema %}