{% style %}
.breadcrumbs {
    padding: 2.3rem 0 0;
}
.pages--about-us .breadcrumbs {
  padding: 2.3rem 0;
}
.breadcrumbs__list {
    list-style-type: none;
    margin: 0;
    padding: 0;
    display: flex;
    /* flex-wrap: wrap; */
    /* align-items: center; */
}
.breadcrumbs__item:not(:first-child) {
    padding-left: 1.6rem;
}
.breadcrumbs__item {
    line-height: 1.6rem;
    position: relative;
}
.breadcrumbs__item:not(:last-child):after {
    border-style: solid;
    border-width: .10em .10em 0 0;
    content: '';
    height: 0.6rem;
    transform: rotate(45deg);
    width: 0.6rem;
    position: absolute;
    top: 6px;
    right: -9px;
}
.breadcrumbs__item .breadcrumbs__link {
    font-size: 1.4rem;
    font-weight: var(--font-body-weight-semibold);
}
.breadcrumbs__item:hover a.breadcrumbs__link {
    color: rgba(var(--color-foreground), .7);
}
.breadcrumbs__link[aria-current="page"] {
    color: inherit;
    text-decoration: none;
}
{% endstyle %}

{%- unless template == 'index' -%}
{%- assign t = template | split: '.' | first -%}

<div class="breadcrumb-main page-width">
    <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
        <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item">
                <a class="breadcrumbs__link" href="/">Home</a>
            </li>
            {%- case t -%}
            {%- when 'page' -%}
                <li class="breadcrumbs__item">
                    <span class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</span>
                </li>
            {%- when 'product' -%}
                {%- if collection.url -%}
                <li class="breadcrumbs__item">
                    {{ collection.title | link_to: collection.url }}
                </li>
                {%- endif -%}
                <li class="breadcrumbs__item">
                    <span class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">{{ product.title }}</span>
                </li>
            {%- when 'collection' and collection.handle -%}
                {%- if current_tags -%}
                <li class="breadcrumbs__item">
                    {{ collection.title | link_to: collection.url }}
                </li>
                <li class="breadcrumbs__item">
                    {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
                    <span class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + "}}</span>
                </li>
                {%- else -%}
                <li class="breadcrumbs__item">
                    <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
                </li>
                {%- endif -%}
            {%- when 'blog' -%}
                {%- if current_tags -%}
                <li class="breadcrumbs__item">
                    {{ blog.title | link_to: blog.url }}
                </li>
                <li class="breadcrumbs__item">
                    {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
                    <span class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: " + " }}</span>
                </li>
                {%- else -%}
                <li class="breadcrumbs__item">
                    <span class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</span>
                </li>
                {%- endif -%}
            {%- when 'article' -%}
                <li class="breadcrumbs__item">
                    {{ blog.title | link_to: blog.url }}
                </li>
                <li class="breadcrumbs__item">
                    <span class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</span>
                </li>
            {%- else -%}
                <li class="breadcrumbs__item">
                    <span class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</span>
                </li>
            {%- endcase -%}
        </ol>
    </nav>
</div>
{%- endunless -%}