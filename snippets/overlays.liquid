            </button>
            <button type="button" class="km-qv-thumb-item" aria-label="Thumbnail 2">
              <img src="{{ 'royal_damascus_talwar.jpg' | asset_url }}" alt="Thumbnail 2" decoding="async" loading="lazy" />
            </button>
            <button type="button" class="km-qv-thumb-item" aria-label="Thumbnail 3">
