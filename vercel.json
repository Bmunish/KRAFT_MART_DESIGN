{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "/api/index.py"
    },
    {
      "source": "/collections/all",
      "destination": "/collections/all/index.html"
    },
    {
      "source": "/collections",
      "destination": "/collections/all/index.html"
    },
    {
      "source": "/products",
      "destination": "/collections/all/index.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/product-detail.html"
    },
    {
      "source": "/blogs/news/:path*",
      "destination": "/blogs/news/wedding-talwar-selection/index.html"
    },
    {
      "source": "/blogs/:path*",
      "destination": "/blogs/index.html"
    },
    {
      "source": "/pages/wedding-swords",
      "destination": "/pages/wedding-swords/index.html"
    },
    {
      "source": "/wedding-swords",
      "destination": "/pages/wedding-swords/index.html"
    },
    {
      "source": "/pages/about",
      "destination": "/pages/about/index.html"
    },
    {
      "source": "/pages/about-us",
      "destination": "/pages/about/index.html"
    },
    {
      "source": "/about",
      "destination": "/pages/about/index.html"
    },
    {
      "source": "/pages/contact",
      "destination": "/pages/contact/index.html"
    },
    {
      "source": "/pages/contact-us",
      "destination": "/pages/contact/index.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact/index.html"
    },
    {
      "source": "/cart",
      "destination": "/cart/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout/index.html"
    },
    {
      "source": "/search",
      "destination": "/search/index.html"
    },
    {
      "source": "/policies/privacy-policy",
      "destination": "/pages/privacy-policy/index.html"
    },
    {
      "source": "/policies/return-policy",
      "destination": "/pages/return-policy/index.html"
    },
    {
      "source": "/policies/refund-policy",
      "destination": "/pages/return-policy/index.html"
    },
    {
      "source": "/policies/shipping-policy",
      "destination": "/pages/shipping-policy/index.html"
    },
    {
      "source": "/policies/processing-time",
      "destination": "/pages/processing-time/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/pages/privacy-policy/index.html"
    },
    {
      "source": "/return-policy",
      "destination": "/pages/return-policy/index.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/pages/return-policy/index.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/pages/shipping-policy/index.html"
    },
    {
      "source": "/processing-time",
      "destination": "/pages/processing-time/index.html"
    }
  ]
}
