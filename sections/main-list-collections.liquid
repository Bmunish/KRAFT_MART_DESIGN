<section class="km-section" style="padding: 64px 0;">
  <div class="km-container">
    <h1 class="km-heading-hero" style="text-align:center;margin-bottom:40px;">{{ section.settings.title | escape }}</h1>
    {% paginate collections by section.settings.collections_per_page %}
      <div class="km-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:24px;">
        {% for collection in collections %}
          <a href="{{ collection.url }}" style="display:block;text-decoration:none;color:inherit;">
            {% if collection.featured_image %}<img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.featured_image.alt | escape }}" loading="lazy" width="600" height="600" style="width:100%;height:auto;aspect-ratio:1;object-fit:cover;">{% endif %}
            <h2>{{ collection.title | escape }}</h2>
            {% if section.settings.show_description and collection.description != blank %}<p>{{ collection.description | strip_html | truncate: 120 }}</p>{% endif %}
          </a>
        {% else %}<p>No collections found.</p>{% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="km-pagination" aria-label="Collection pages" style="display:flex;justify-content:center;gap:8px;margin-top:36px;">{{ paginate | default_pagination }}</nav>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Collections" },
    { "type": "range", "id": "collections_per_page", "label": "Collections per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "show_description", "label": "Show collection descriptions", "default": true }
  ],
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
