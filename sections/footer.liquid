<!-- Footer -->
<footer class="km-footer" style="background-color: var(--color-midnight-ink); border-top: 1px solid var(--color-ld-graphite);">
  <div class="km-container">
    <div class="km-footer-grid">
      <div class="km-footer-brand">
        <a href="{{ routes.root_url }}" class="km-header-logo" style="color: #FFF; margin-bottom: 16px;">
          {% if section.settings.logo %}
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" loading="lazy" decoding="async" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-ld-steel);" />
          {% else %}
            <img src="{{ 'logo.jpeg' | asset_url }}" alt="KraftMart Logo" loading="lazy" decoding="async" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-ld-steel);" />
          {% endif %}
          <span>Kraft<span style="color: var(--km-gold-primary);">Mart</span></span>
        </a>
        <p style="color: var(--color-ld-fog);">
          {{ section.settings.brand_bio | default: "Handcrafted Indian wedding swords, Rajput talwars, and Sikh ceremonial heritage objects forged in Amritsar, Punjab since 1996. Our USP: Affordable swords at your doorstep with a pinch of customisation." }}
        </p>

        <!-- Newsletter Capture Form -->
        {% form 'customer', style: "display: flex; gap: 8px; max-width: 380px; margin-top: 20px;" %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Enter your email for private offers..." required
            style="background: var(--color-ld-carbon); border: 1px solid var(--color-ld-graphite); padding: 12px 16px; border-radius: 8px; color: #FFF; width: 100%; font-size: 0.875rem;" />
          <button type="submit" aria-label="Subscribe"
            style="background-color: var(--color-signal-blue, #C5A059); color: #FFF; padding: 12px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap; flex-shrink: 0;">
            →
          </button>
        {% endform %}
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="km-footer-title">{{ section.settings.menu_1_title | default: "Quick Links" }}</h4>
        <ul class="km-footer-links">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">All Products</a></li>
          <li><a href="/pages/wedding-swords">Wedding Swords</a></li>
          <li><a href="/pages/about">About KraftMart</a></li>
          <li><a href="{{ routes.all_blogs_url | default: '/blogs' }}">Journal</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Policies -->
      <div>
        <h4 class="km-footer-title">{{ section.settings.menu_2_title | default: "Our Policies" }}</h4>
        <ul class="km-footer-links">
          <li><a href="/pages/shipping-policy">Shipping &amp; Delivery</a></li>
          <li><a href="/pages/processing-time">Processing Time Policy</a></li>
          <li><a href="/pages/return-policy">Refund &amp; Return Policy</a></li>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4 class="km-footer-title">{{ section.settings.connect_title | default: "Connect With Us" }}</h4>
        <ul class="km-footer-links">
          <li><span>📍 {{ section.settings.contact_address | default: "Amritsar, Punjab, India" }}</span></li>
          <li><span>📞 <a href="tel:{{ section.settings.contact_phone | default: '+917508427731' }}" style="color: inherit;">{{ section.settings.contact_phone | default: "+91-75084-27731" }}</a></span></li>
          <li><span>📧 <a href="mailto:{{ section.settings.contact_email | default: 'support@kraftmart.shop' }}" style="color: inherit;">{{ section.settings.contact_email | default: "support@kraftmart.shop" }}</a></span></li>
          <li><span>💬 <a href="https://wa.me/{{ section.settings.whatsapp_number | default: '917508427731' }}" target="_blank" rel="noopener noreferrer" style="color: inherit;">WhatsApp COD Support</a></span></li>
          <li><a href="{{ section.settings.google_url | default: 'https://www.google.com/search?sca_esv=9690ff17f276db6e&rlz=1C1FHFK_enIN1105IN1105&sxsrf=APpeQnuC7VLyucK3RXEanRReOrH--HBCyw:1790882647447&kgmid=/g/11q2rz95sv&q=Lakshmi+Engineering+Works+A.K.A+Kraftmart.shop' }}" target="_blank" rel="noopener noreferrer" style="color: #4285F4; display: inline-flex; align-items: center; gap: 6px; font-weight: 600;"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg> Verified Google Business (4.9 ★)</a></li>
          <li><span>✈️ FedEx &amp; DHL Express Shipping</span></li>
        </ul>
      </div>
    </div>

    <div class="km-footer-bottom">
      <div>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. {{ section.settings.copyright_subtext | default: "All Rights Reserved. Handcrafted in Amritsar, India." }}</div>
      <div>{{ section.settings.footer_usp | default: "Our USP: Affordable swords at your doorstep with a pinch of customisation • COD Available" }}</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand Description",
      "default": "Handcrafted Indian wedding swords, Rajput talwars, and Sikh ceremonial heritage objects forged in Amritsar, Punjab since 1996. Our USP: Affordable swords at your doorstep with a pinch of customisation."
    },
    {
      "type": "header",
      "content": "Contact Info"
    },
    {
      "type": "text",
      "id": "connect_title",
      "label": "Contact Column Title",
      "default": "Connect With Us"
    },
    {
      "type": "text",
      "id": "contact_address",
      "label": "Address",
      "default": "Amritsar, Punjab, India"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone Number",
      "default": "+91-75084-27731"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email Address",
      "default": "support@kraftmart.shop"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Number (with country code)",
      "default": "917508427731"
    },
    {
      "type": "url",
      "id": "google_url",
      "label": "Google Business Link"
    },
    {
      "type": "header",
      "content": "Footer Bottom"
    },
    {
      "type": "text",
      "id": "copyright_subtext",
      "label": "Copyright Note",
      "default": "All Rights Reserved. Handcrafted in Amritsar, India."
    },
    {
      "type": "text",
      "id": "footer_usp",
      "label": "Bottom Tagline",
      "default": "Our USP: Affordable swords at your doorstep with a pinch of customisation • COD Available"
    }
  ]
}
{% endschema %}
