<!-- Footer -->
<footer class="km-footer" style="background-color: var(--color-midnight-ink); border-top: 1px solid var(--color-ld-graphite);">
  <div class="km-container">
    <div class="km-footer-grid">
      <div class="km-footer-brand">
        <a href="{{ routes.root_url }}" class="km-header-logo" style="color: #FFF; margin-bottom: 16px;">
          {% if section.settings.logo %}
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" loading="lazy" decoding="async" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-ld-steel);" />
          {% else %}
            <img src="{{ 'logo.jpeg' | asset_url }}" alt="KraftMart Logo" loading="lazy" decoding="async" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-ld-steel);" />
          {% endif %}
          <span>Kraft<span style="color: var(--km-gold-primary);">Mart</span></span>
        </a>
        <p style="color: var(--color-ld-fog);">Handcrafted Indian wedding swords, Rajput talwars, and Sikh ceremonial heritage objects forged in Amritsar, Punjab since 1996. <strong>Our USP: Affordable swords at your doorstep with a pinch of customisation.</strong></p>

        <!-- Newsletter Capture Form -->
        {% form 'customer', style: "display: flex; gap: 8px; max-width: 380px; margin-top: 20px;" %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Enter your email for private offers..." required
            style="background: var(--color-ld-carbon); border: 1px solid var(--color-ld-graphite); padding: 12px 16px; border-radius: 8px; color: #FFF; width: 100%; font-size: 0.875rem;" />
          <button type="submit" aria-label="Subscribe"
            style="background-color: var(--color-signal-blue, #C5A059); color: #FFF; padding: 12px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; white-space: nowrap; flex-shrink: 0;">
            →
          </button>
        {% endform %}
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="km-footer-title">Quick Links</h4>
        <ul class="km-footer-links">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">All Products</a></li>
          <li><a href="/pages/wedding-swords">Wedding Swords</a></li>
          <li><a href="/pages/about">About KraftMart</a></li>
          <li><a href="{{ routes.all_blogs_url | default: '/blogs' }}">Journal</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Policies -->
      <div>
        <h4 class="km-footer-title">Our Policies</h4>
        <ul class="km-footer-links">
          <li><a href="/policies/shipping-policy">Shipping &amp; Delivery</a></li>
          <li><a href="/policies/processing-time">Processing Time Policy</a></li>
          <li><a href="/policies/refund-policy">Refund &amp; Return Policy</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4 class="km-footer-title">Connect With Us</h4>
        <ul class="km-footer-links">
          <li><span>📍 Amritsar, Punjab, India</span></li>
          <li><span>📞 <a href="tel:+917508427731" style="color: inherit;">+91-75084-27731</a></span></li>
          <li><span>📧 <a href="mailto:support@kraftmart.shop" style="color: inherit;">support@kraftmart.shop</a></span></li>
          <li><span>💬 <a href="https://wa.me/917508427731" target="_blank" rel="noopener noreferrer" style="color: inherit;">WhatsApp COD Support</a></span></li>
          <li><a href="https://www.google.com/search?sca_esv=9690ff17f276db6e&amp;rlz=1C1FHFK_enIN1105IN1105&amp;sxsrf=APpeQnuC7VLyucK3RXEanRReOrH--HBCyw:1790882647447&amp;kgmid=/g/11q2rz95sv&amp;q=Lakshmi+Engineering+Works+A.K.A+Kraftmart.shop&amp;shem=dlvs1,epsd1,esd2e,ltae,rimspwouoe&amp;shndl=30&amp;source=sh/x/loc/uni/m1/1&amp;kgs=ac419447525adea1&amp;utm_source=dlvs1,epsd1,esd2e,ltae,rimspwouoe,sh/x/loc/uni/m1/1#lrd=0x39197d192e9f82b5:0x73a13ed215287278,1,,,," target="_blank" rel="noopener noreferrer" style="color: #4285F4; display: inline-flex; align-items: center; gap: 6px; font-weight: 600;"><svg width="14" height="14" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg> Verified Google Business (4.9 ★)</a></li>
          <li><span>✈️ FedEx &amp; DHL Express Shipping</span></li>
        </ul>
      </div>
    </div>

    <div class="km-footer-bottom">
      <div>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved. Handcrafted in Amritsar, India.</div>
      <div>Our USP: Affordable swords at your doorstep with a pinch of customisation &bull; COD Available</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    }
  ],
  "blocks": []
}
{% endschema %}
