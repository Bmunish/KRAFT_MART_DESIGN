{% schema %}
{
  "name": "Testimonials Marquee",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subtitle",
      "default": "VERIFIED ROYAL REVIEWS & PATRON EXPERIENCES"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trusted by 10,000+ Grooms Worldwide"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Every sword is forged by multigenerational Amritsar artisans and accompanied by our Lineage Guarantee."
    },
    {
      "type": "header",
      "content": "Google Business Card"
    },
    {
      "type": "text",
      "id": "google_banner_title",
      "label": "Business Name",
      "default": "Lakshmi Engineering Works A.K.A Kraftmart.shop"
    },
    {
      "type": "text",
      "id": "google_rating",
      "label": "Rating Score",
      "default": "4.9 / 5"
    },
    {
      "type": "text",
      "id": "google_button_label",
      "label": "Button Label",
      "default": "Open Google Business Reviews"
    },
    {
      "type": "url",
      "id": "google_review_url",
      "label": "Google Reviews URL"
    }
  ],
  "presets": [
    {
      "name": "Testimonials Marquee"
    }
  ]
}
{% endschema %}
