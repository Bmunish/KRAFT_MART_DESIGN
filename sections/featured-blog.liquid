<section class="featured-blog" style="background: {{ section.settings.background_color }}; padding: 48px 20px;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;text-align:{{ section.settings.heading_alignment }};">
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.show_view_all and section.settings.blog != blank %}<a href="{{ section.settings.blog.url }}">View all</a>{% endif %}
    </div>
    {% if section.settings.blog != blank %}
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;">
        {% for article in section.settings.blog.articles limit: section.settings.post_limit %}
          <article>
            {% if article.image %}<a href="{{ article.url }}"><img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="600" height="{{ 600 | divided_by: article.image.aspect_ratio | round }}"></a>{% endif %}
            <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </article>
        {% else %}<p>No articles found in this blog.</p>{% endfor %}
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Featured blog",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_limit", "label": "Posts to show", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the blog" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FAF7F2" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all link", "default": true }
  ],
  "presets": [{ "name": "Featured blog" }]
}
{% endschema %}
