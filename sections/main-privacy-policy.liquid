<section class="km-section" style="padding: 64px 0 80px; background: var(--km-bg-main, #fcfbf9);">
  <div class="km-container">
    <div class="km-policy-page-wrap km-reveal">
        
        <!-- Tabbed Policy Navigation Strip -->
        <div class="km-policy-nav-strip">
          <a href="/pages/shipping-policy" class="km-policy-tab-link">🚚 Shipping Policy</a>
          <a href="/pages/processing-time" class="km-policy-tab-link">⏱️ Processing Time</a>
          <a href="/pages/return-policy" class="km-policy-tab-link">↩ Returns &amp; Refunds</a>
          <a href="/pages/privacy-policy" class="km-policy-tab-link active">🔒 Privacy Policy</a>
          <a href="/pages/contact" class="km-policy-tab-link">✉ Contact Us</a>
        </div>

        <!-- 3 Feature Highlight Cards -->
        <div class="km-policy-feature-grid">
          <div class="km-policy-feature-card">
            <div class="km-policy-feature-icon">🔒</div>
            <div>
              <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ section.settings.feat_1_title | default: "256-Bit Encryption" }}</strong>
              <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ section.settings.feat_1_desc | default: "All order transactions and personal data are strictly encrypted." }}</span>
            </div>
          </div>

          <div class="km-policy-feature-card">
            <div class="km-policy-feature-icon">🚫</div>
            <div>
              <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ section.settings.feat_2_title | default: "Zero Data Selling" }}</strong>
              <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ section.settings.feat_2_desc | default: "We never monetize, rent, or sell customer contact information." }}</span>
            </div>
          </div>

          <div class="km-policy-feature-card">
            <div class="km-policy-feature-icon">📦</div>
            <div>
              <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ section.settings.feat_3_title | default: "Logistics Only" }}</strong>
              <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ section.settings.feat_3_desc | default: "Information shared strictly with couriers (FedEx/DHL) for delivery." }}</span>
            </div>
          </div>
        </div>

        <!-- Section 1: Overview -->
        <div class="km-policy-section-block">
          <div style="font-size: 0.8rem; color: var(--km-gold-dark); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">
            LAST UPDATED: {{ section.settings.last_updated | default: "MAY 17, 2025" }}
          </div>
          <p>
            {{ section.settings.overview_text | default: "This Privacy Policy describes how KraftMart (a subsidiary of Lakshmi Engineering Works, collectively 'we', 'us', or 'our') collects, uses, and discloses your personal information when you visit, use our services, or make a purchase from kraftmart.shop." }}
          </p>
        </div>

        <!-- Section 2: What We Collect -->
        <div class="km-policy-section-block">
          <h2><span>📋</span> Personal Information We Collect</h2>
          <p>To craft and deliver your personalized heritage pieces, we collect the following essential information:</p>
          <ul class="km-policy-list">
            <li><strong>Customer Details:</strong> Full name, billing address, shipping destination address, email address, and mobile phone number (for SMS/WhatsApp delivery notifications).</li>
            <li><strong>Bespoke Customization Data:</strong> Custom laser engraving names, wedding dates, family crest emblems, or Gurmukhi hymns submitted during checkout.</li>
            <li><strong>Payment Verification:</strong> Payment transaction confirmation IDs (note: complete credit card numbers and CVV codes are processed directly through secure PCI-DSS payment gateways and are never stored on our servers).</li>
            <li><strong>Customer Support Records:</strong> Order inquiries, sizing consultations, and unboxing verification communications.</li>
          </ul>
        </div>

        <!-- Section 3: How We Use Your Information -->
        <div class="km-policy-section-block">
          <h2><span>⚙️</span> How We Use Your Information</h2>
          <ul class="km-policy-list">
            <li><strong>Order Fulfillment:</strong> To forge, polish, assemble, laser engrave, and securely package your chosen articles.</li>
            <li><strong>Courier Transit:</strong> To generate shipping manifests and airway bills with courier partners (FedEx Express, DHL, Delhivery, DTDC, India Post).</li>
            <li><strong>Customer Support:</strong> To provide live order tracking, engraving mockups, and respond to your inquiries promptly.</li>
            <li><strong>Legal &amp; Fraud Prevention:</strong> To screen transactions for unauthorized access and comply with domestic trade and export laws.</li>
          </ul>
        </div>

        <!-- Notice Box: Security Commitment -->
        <div class="km-policy-notice-box">
          <div style="font-family: var(--km-font-display); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--km-gold-dark); margin-bottom: 8px;">
            🔒 Security &amp; Data Protection Commitment
          </div>
          <p style="color: var(--km-text-primary); font-size: 0.92rem; line-height: 1.7; margin: 0;">
            {{ section.settings.security_commitment | default: "We maintain strict administrative, technical, and physical safeguards to prevent unauthorized access, loss, or alteration of your personal data. We will never sell, rent, or trade your personal records with third-party advertising brokers." }}
          </p>
        </div>

        <!-- Section 4: Your Rights & Contact -->
        <div class="km-policy-section-block">
          <h2><span>✉️</span> Your Rights &amp; Privacy Contact</h2>
          <p>
            You have the right to request access to the personal data we hold about you, request corrections, or request deletion of your account records. To exercise these rights or for any privacy questions:
          </p>
          <ul class="km-policy-list">
            <li><strong>Company:</strong> {{ section.settings.company_name | default: "Lakshmi Engineering Works / KraftMart" }}</li>
            <li><strong>Helpline:</strong> {{ section.settings.contact_helpline | default: "+91-75084-27731 / +91-92178-00003" }}</li>
            <li><strong>Email:</strong> {{ section.settings.contact_email | default: "support@kraftmart.shop / kraftengineering2024@gmail.com" }}</li>
            <li><strong>Location:</strong> {{ section.settings.contact_location | default: "Land of Five Rivers, Amritsar, Punjab, India" }}</li>
          </ul>
        </div>

      </div>

    </div>
  </section>

