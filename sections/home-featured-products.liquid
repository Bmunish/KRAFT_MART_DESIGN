          data-qv-price="₹4,299" data-qv-compare=""
          data-qv-specs="Blade Length: 30 in|Hilt: Brass Rajput Grip|Scabbard: Zari Velvet Sheath|Dispatch: 5–7 Days">
          <div class="km-product-media">
