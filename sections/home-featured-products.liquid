          </div>
        </div>
        <!-- Card 8 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="8" data-category="damascus"
          data-qv-img="assets/sword2.png" data-qv-title="Mughal Court Talwar"
          data-qv-desc="Museum-grade Mughal court sword with inlaid brass filigree work and traditional courtly proportions"
