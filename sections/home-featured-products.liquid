        <div class="km-product-card km-noise-card km-reveal" data-delay="7" data-category="wedding" data-handle="sikh-groom-ceremonial-talwar"
          data-qv-img="/assets/sword.png" data-qv-title="Sikh Groom Ceremonial Talwar"
