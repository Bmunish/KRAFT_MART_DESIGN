          </div>
        </div>

        <!-- Card 5 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="5" data-category="miniature" data-handle="miniature-khanda-sahib-shield"
          data-qv-img="/assets/sword2.png" data-qv-title="Miniature Khanda Sahib Shield"
          data-qv-desc="Solid cast brass miniature Khanda with dual crossed kirpans and chakkar. Perfect for car dashboards and home altars."
          data-qv-price="₹1,299" data-qv-compare=""
          data-qv-specs="Material: Solid Brass Casting|Finish: Lacquered Antique Gold|Base: Felt-lined Stand|Size: 6.5 in">
          <div class="km-product-media">
            <span class="km-sale-badge">Auspicious</span>
            <img src="{{ 'sword2.png' | asset_url }}" alt="Miniature Khanda Sahib Shield" class="km-product-img" decoding="async" loading="lazy" />
            <button class="km-quick-view-btn">⚡ Quick View</button>
          </div>
          <div class="km-product-info">
