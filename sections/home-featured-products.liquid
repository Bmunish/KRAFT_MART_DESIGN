<!-- Featured Products Grid — Dynamic Collection or Curated Catalogue -->
<section id="featured-products" class="km-section km-featured-compact" style="background-color: var(--color-cloud); padding: 36px 0 54px 0;">
  <div class="km-container">
    <div class="km-section-header km-header-compact" style="margin: 0 auto 20px auto;">
      <span class="km-eyebrow" style="margin-bottom: 4px; font-size: 0.72rem; letter-spacing: 0.12em;">{{ section.settings.subtitle | default: "CURATED HERITAGE PICKS" }}</span>
      <h2 class="km-heading-1 km-heading-featured" style="color: var(--km-text-primary); font-size: clamp(1.8rem, 3.2vw, 2.4rem); margin: 4px 0 6px 0; line-height: 1.15;">{{ section.settings.title | default: "Ceremonial Collection" }}</h2>
      <p class="km-body-lead km-lead-compact" style="color: var(--km-text-secondary); margin-bottom: 16px; font-size: 0.88rem; line-height: 1.45;">
        {{ section.settings.description | default: "Hand-forged talwars with premium scabbards and complimentary name engraving." }}
      </p>

      {% if section.settings.show_tabs %}
        <!-- Heritage Segmented Tab Control -->
        <div class="km-segmented-tabs" style="margin-bottom: 20px; padding: 3px; gap: 3px;">
          <button class="km-tab-btn active" data-tab="all" style="padding: 7px 16px; font-size: 0.75rem;">{{ section.settings.tab_all_label | default: "All Catalogue" }}</button>
          <button class="km-tab-btn" data-tab="wedding" style="padding: 7px 16px; font-size: 0.75rem;">{{ section.settings.tab_wedding_label | default: "Wedding Swords" }}</button>
          <button class="km-tab-btn" data-tab="damascus" style="padding: 7px 16px; font-size: 0.75rem;">{{ section.settings.tab_damascus_label | default: "Damascus Steel" }}</button>
          <button class="km-tab-btn" data-tab="miniature" style="padding: 7px 16px; font-size: 0.75rem;">{{ section.settings.tab_miniature_label | default: "Miniatures" }}</button>
        </div>
      {% endif %}
    </div>

    <div class="km-product-grid" data-live-mode="home" aria-live="polite">
      {% assign chosen_collection = collections[section.settings.collection] %}
      {% if chosen_collection != blank and chosen_collection.products_count > 0 %}
        {% for product in chosen_collection.products limit: section.settings.products_to_show %}
          {% assign cat_handle = "wedding" %}
          {% if product.tags contains "damascus" or product.title contains "Damascus" %}
            {% assign cat_handle = "damascus" %}
          {% elsif product.tags contains "miniature" or product.title contains "Miniature" %}
            {% assign cat_handle = "miniature" %}
          {% endif %}
          <div class="km-product-card km-noise-card km-reveal" data-delay="{{ forloop.index }}" data-category="{{ cat_handle }}" data-handle="{{ product.handle }}"
            data-qv-img="{{ product.featured_image | img_url: '600x' }}" data-qv-title="{{ product.title | escape }}"
            data-qv-desc="{{ product.description | strip_html | truncatewords: 16 | escape }}"
            data-qv-price="{{ product.price | money }}" data-qv-compare="{{ product.compare_at_price | money }}"
            data-qv-specs="Handcrafted Amritsar Forging | Free Custom Laser Engraving | Tracked Express Delivery">
            <div class="km-product-media">
              {% if product.compare_at_price > product.price %}
                <span class="km-sale-badge">Sale</span>
              {% endif %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="km-product-img" decoding="async" loading="lazy" />
              <button class="km-quick-view-btn" data-qv-handle="{{ product.handle }}">⚡ Quick View</button>
            </div>
            <div class="km-product-info">
              <span class="km-product-vendor">{{ product.vendor | default: "KraftMart Heritage" }}</span>
              <h3 class="km-product-title"><a href="{{ product.url }}" style="color: inherit; text-decoration: none;">{{ product.title }}</a></h3>
              <p class="km-product-desc-short">{{ product.description | strip_html | truncatewords: 8 }}</p>
              <div class="km-price-wrapper">
                <span class="km-price-current">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="km-price-compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              <form method="post" action="/cart/add" style="margin: 0;">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="button" class="km-add-cart-btn" data-action="open-cart">Add to Cart</button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <!-- Curated Catalogue Fallback -->
        <!-- Card 1 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="1" data-category="wedding" data-handle="jaipur-wedding-talwar"
          data-qv-img="/assets/sword.png" data-qv-title="Jaipur Wedding Talwar"
          data-qv-desc="Red Velvet Scabbard · Kundan Brass Hilt · Free Laser Engraving · Ceremonial Grade"
          data-qv-price="₹2,599" data-qv-compare="₹3,099"
          data-qv-specs="Blade Length: 28 in|Hilt: Solid Brass Kundan|Scabbard: Deep Red Velvet|Dispatch: 5–7 Days">
          <div class="km-product-media">
            <span class="km-sale-badge">Save ₹500</span>
            <img src="{{ 'sword.png' | asset_url }}" alt="Jaipur Wedding Talwar" class="km-product-img" decoding="async" loading="lazy" />
            <button class="km-quick-view-btn">⚡ Quick View</button>
          </div>
          <div class="km-product-info">
            <span class="km-product-vendor">KraftMart Heritage</span>
            <h3 class="km-product-title">Jaipur Wedding Talwar</h3>
            <p class="km-product-desc-short">Kundan Brass Hilt · Deep Red Velvet Scabbard</p>
            <div class="km-price-wrapper">
              <span class="km-price-current">₹2,599</span>
              <span class="km-price-compare">₹3,099</span>
            </div>
            <button class="km-add-cart-btn" data-action="open-cart">Add to Cart</button>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="2" data-category="damascus" data-handle="royal-jodhpur-damascus"
          data-qv-img="/assets/sword2.png" data-qv-title="Kundan Hilt Rajput Talwar"
          data-qv-desc="Authentic Damascus Steel · Semi-precious kundan stone hilt · Museum-grade forging by Amritsar masters"
          data-qv-price="₹4,299" data-qv-compare="₹4,999"
          data-qv-specs="Steel: 1095/15N20 Damascus|Hardness: 56–58 HRC|Hilt: Kundan with Semi-precious Stones|Blade: 30 in">
          <div class="km-product-media">
            <span class="km-sale-badge">Popular</span>
