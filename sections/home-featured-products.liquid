<!-- Featured Products Grid — Expanded 8-product catalogue (Compact Layout) -->
  <section id="featured-products" class="km-section km-featured-compact" style="background-color: var(--color-cloud); padding: 36px 0 54px 0;">
    <div class="km-container">
      <div class="km-section-header km-header-compact" style="margin: 0 auto 20px auto;">
        <span class="km-eyebrow" style="margin-bottom: 4px; font-size: 0.72rem; letter-spacing: 0.12em;">{{ section.settings.subtitle | default: "CURATED HERITAGE PICKS" }}</span>
        <h2 class="km-heading-1 km-heading-featured" style="color: var(--km-text-primary); font-size: clamp(1.8rem, 3.2vw, 2.4rem); margin: 4px 0 6px 0; line-height: 1.15;">{{ section.settings.title | default: "Ceremonial Collection" }}</h2>
        <p class="km-body-lead km-lead-compact" style="color: var(--km-text-secondary); margin-bottom: 16px; font-size: 0.88rem; line-height: 1.45;">
          {{ section.settings.description | default: "Hand-forged talwars with premium scabbards and complimentary name engraving." }}</p>
        <!-- Heritage Segmented Tab Control -->
        <div class="km-segmented-tabs" style="margin-bottom: 20px; padding: 3px; gap: 3px;">
          <button class="km-tab-btn active" data-tab="all" style="padding: 7px 16px; font-size: 0.75rem;">All Catalogue</button>
          <button class="km-tab-btn" data-tab="wedding" style="padding: 7px 16px; font-size: 0.75rem;">Wedding Swords</button>
          <button class="km-tab-btn" data-tab="damascus" style="padding: 7px 16px; font-size: 0.75rem;">Damascus Steel</button>
          <button class="km-tab-btn" data-tab="miniature" style="padding: 7px 16px; font-size: 0.75rem;">Miniatures</button>
        </div>
      </div>

      <div class="km-product-grid" data-live-products="12" data-live-mode="home" aria-live="polite">
        <!-- Card 1 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="1" data-category="wedding"
          data-qv-img="assets/sword.png" data-qv-title="Jaipur Wedding Talwar"
          data-qv-desc="Red Velvet Scabbard · Kundan Brass Hilt · Free Laser Engraving · Ceremonial Grade"
          data-qv-price="₹2,599" data-qv-compare="₹3,099"
          data-qv-specs="Blade Length: 28 in|Hilt: Solid Brass Kundan|Scabbard: Deep Red Velvet|Dispatch: 5–7 Days">
          <div class="km-product-media">
            <span class="km-sale-badge">Save ₹500</span>
            <img src="{{ 'sword.png' | asset_url }}" alt="Jaipur Wedding Talwar" class="km-product-img" decoding="async" loading="lazy" />
            <button class="km-quick-view-btn">⚡ Quick View</button>
          </div>
          <div class="km-product-info">
            <span class="km-product-vendor">KraftMart Heritage</span>
            <h3 class="km-product-title">Jaipur Wedding Talwar</h3>
            <p class="km-product-desc-short">Kundan Brass Hilt · Deep Red Velvet Scabbard</p>
            <div class="km-price-wrapper">
              <span class="km-price-current">₹2,599</span>
              <span class="km-price-compare">₹3,099</span>
            </div>
            <button class="km-add-cart-btn" data-action="open-cart">Add to Cart</button>
          </div>
        </div>
        <!-- Card 2 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="2" data-category="damascus"
          data-qv-img="assets/sword2.png" data-qv-title="Kundan Hilt Rajput Talwar"
          data-qv-desc="Authentic Damascus Steel · Semi-precious kundan stone hilt · Museum-grade forging by Amritsar masters"
          data-qv-price="₹4,299" data-qv-compare="₹4,999"
          data-qv-specs="Steel: 1095/15N20 Damascus|Hardness: 56–58 HRC|Hilt: Kundan with Semi-precious Stones|Blade: 30 in">
          <div class="km-product-media">
            <span class="km-sale-badge">Popular</span>
            <img src="{{ 'sword2.png' | asset_url }}" alt="Kundan Hilt Rajput Talwar" class="km-product-img" decoding="async" loading="lazy" />
            <button class="km-quick-view-btn">⚡ Quick View</button>
          </div>
          <div class="km-product-info">
            <span class="km-product-vendor">KraftMart Heritage</span>
            <h3 class="km-product-title">Kundan Hilt Rajput Talwar</h3>
            <p class="km-product-desc-short">Damascus Steel · Kundan Semi-precious Hilt</p>
            <div class="km-price-wrapper">
              <span class="km-price-current">₹4,299</span>
              <span class="km-price-compare">₹4,999</span>
            </div>
            <button class="km-add-cart-btn" data-action="open-cart">Add to Cart</button>
          </div>
        </div>
        <!-- Card 3 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="3" data-category="wedding"
