        <!-- Card 7 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="7" data-category="miniature"
          data-qv-img="assets/sword.png" data-qv-title="Miniature Kirpan Gift Set"
          data-qv-desc="Collectible 10-inch miniature Kirpan in premium gift box · Perfect for gifting at Sikh ceremonies"
          data-qv-price="₹899" data-qv-compare="₹1,199"
          data-qv-specs="Size: 10 in Miniature|Packaging: Premium Gift Box|Material: Stainless + Brass|Use: Ceremonial Gift">
          <div class="km-product-media">
            <span class="km-sale-badge">COD Available</span>
            <img src="{{ 'sword.png' | asset_url }}" alt="Miniature Kirpan Set" class="km-product-img" decoding="async" loading="lazy" />
            <button class="km-quick-view-btn">⚡ Quick View</button>
          </div>
          <div class="km-product-info">
            <span class="km-product-vendor">KraftMart Heritage</span>
            <h3 class="km-product-title">Miniature Kirpan Gift Set</h3>
            <p class="km-product-desc-short">Collectible 10" · Premium Gift Box</p>
