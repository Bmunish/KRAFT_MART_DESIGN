        <!-- Card 5 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="5" data-category="damascus"
          data-qv-img="assets/sword2.png" data-qv-title="Royal Jodhpur Damascus Talwar"
          data-qv-desc="Hand-forged 1095/15N20 Damascus blade with intricate brass guard and deep burgundy velvet scabbard"
