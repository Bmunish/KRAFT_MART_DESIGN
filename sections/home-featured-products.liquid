          <div class="km-product-media">
            <img src="{{ 'sword2.png' | asset_url }}" alt="Mughal Court Talwar" class="km-product-img" decoding="async" loading="lazy" />
            <button class="km-quick-view-btn">⚡ Quick View</button>
          </div>
          <div class="km-product-info">
            <span class="km-product-vendor">KraftMart Heritage</span>
            <h3 class="km-product-title">Mughal Court Talwar</h3>
