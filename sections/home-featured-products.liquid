        <!-- Card 6 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="6" data-category="wedding"
          data-qv-img="assets/hero_talwar.png" data-qv-title="Shekhawati Bridal Talwar"
          data-qv-desc="Gold-plated hilt with white zari velvet scabbard · Ideal for brides and royal wedding ceremonies"
          data-qv-price="₹3,299" data-qv-compare=""
          data-qv-specs="Hilt: Gold-Plated Brass|Scabbard: White Zari Velvet|Blade: 28 in Polished|Engraving: Free">
          <div class="km-product-media">
