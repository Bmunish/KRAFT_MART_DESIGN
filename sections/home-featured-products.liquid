        <!-- Card 8 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="8" data-category="damascus" data-handle="royal-jodhpur-damascus-talwar"
          data-qv-img="/assets/sword2.png" data-qv-title="Royal Jodhpur Damascus Talwar"
          data-qv-desc="Master forged 1095/15N20 layered Damascus steel ceremonial sword. Museum display finish with midnight blue velvet sheath."
          data-qv-price="₹4,299" data-qv-compare="₹4,999"
          data-qv-specs="Steel: 1095/15N20 Damascus|Hardness: 56–58 HRC|Scabbard: Midnight Blue Velvet|Hilt: Chased Brass">
