        <!-- Card 6 -->
        <div class="km-product-card km-noise-card km-reveal" data-delay="6" data-category="damascus" data-handle="amritsar-royal-damascus-kirpan"
          data-qv-img="/assets/hero_talwar.png" data-qv-title="Amritsar Royal Damascus Kirpan"
