      {% endif %}
    </div>

    <div style="text-align: center; margin-top: 48px;">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="km-btn km-btn-outline-gold" style="padding: 14px 36px;">
        {{ section.settings.button_label | default: "View Complete Collection →" }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Eyebrow Subtitle",
      "default": "CURATED HERITAGE PICKS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Ceremonial Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand-forged talwars with premium scabbards and complimentary name engraving."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection of Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Number of Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show Category Filter Tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "tab_all_label",
      "label": "Tab 1 Label",
      "default": "All Catalogue"
    },
    {
      "type": "text",
      "id": "tab_wedding_label",
      "label": "Tab 2 Label",
      "default": "Wedding Swords"
    },
    {
      "type": "text",
      "id": "tab_damascus_label",
      "label": "Tab 3 Label",
      "default": "Damascus Steel"
    },
    {
      "type": "text",
      "id": "tab_miniature_label",
      "label": "Tab 4 Label",
      "default": "Miniatures"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View Complete Collection →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
