{%- assign pad_top = section.settings.padding_top -%}
{%- assign pad_bot = section.settings.padding_bottom -%}

<section class="km-section km-page-returns" style="padding: {{ pad_top }}px 0 {{ pad_bot }}px; background: {{ section.settings.bg_color }};">
  <div class="km-container" style="max-width: {{ section.settings.container_width }}px; margin: 0 auto; text-align: {{ section.settings.text_alignment }};">

    <div class="km-policy-nav-strip" style="margin-bottom: 32px;">
      <a href="/policies/shipping-policy" class="km-policy-tab-link">🚚 Shipping</a>
      <a href="/pages/processing-time" class="km-policy-tab-link">⏱️ Processing</a>
      <a href="/policies/refund-policy" class="km-policy-tab-link active">↩ Returns</a>
      <a href="/policies/privacy-policy" class="km-policy-tab-link">🔒 Privacy</a>
      <a href="/pages/contact" class="km-policy-tab-link">✉ Contact</a>
    </div>

    <h1 class="km-heading-1" style="font-size: {{ section.settings.title_size }}px; margin-bottom: 8px; color: var(--km-text-primary);">
      {{ page.title | default: "Returns & Refund Policy" }}
    </h1>
    <div style="width: 56px; height: 3px; background: linear-gradient(90deg, var(--km-gold-primary), var(--km-gold-dark)); border-radius: 2px; margin-bottom: 28px;"></div>

    {%- comment %} ── Eligibility Badges ── {%- endcomment %}
    {%- assign has_badges = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'eligibility_badge' -%}{%- assign has_badges = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_badges %}
    <div class="km-policy-feature-grid" style="margin-bottom: 36px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'eligibility_badge' -%}
        <div class="km-policy-feature-card" {{ block.shopify_attributes }}>
          <div class="km-policy-feature-icon">{{ block.settings.icon }}</div>
          <div>
            <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ block.settings.title }}</strong>
            <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ block.settings.description }}</span>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif %}

    {%- comment %} ── Return Steps ── {%- endcomment %}
    {%- assign has_steps = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'return_step' -%}{%- assign has_steps = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_steps %}
    <div class="km-policy-section-block" style="margin-bottom: 28px;">
      <h2><span>📋</span> {{ section.settings.steps_heading | default: "Step-by-Step Return Process" }}</h2>
      <ol style="padding-left: 22px; margin-top: 14px;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'return_step' -%}
          <li {{ block.shopify_attributes }} style="margin-bottom: 14px; padding-left: 8px; color: var(--km-text-secondary); line-height: 1.65;">
            <strong style="color: var(--km-text-primary); display: block; margin-bottom: 3px; font-size: 0.95rem;">{{ block.settings.step_title }}</strong>
            {{ block.settings.step_detail }}
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
    {%- endif %}

    {%- comment %} ── FAQ Items ── {%- endcomment %}
    {%- assign has_faq = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}{%- assign has_faq = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_faq %}
    <div class="km-policy-section-block" style="margin-bottom: 28px;">
      <h2><span>❓</span> Frequently Asked Questions</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
        <details class="km-faq-item" style="border: 1px solid rgba(197,160,89,0.2); border-radius: 8px; margin-top: 10px; overflow: hidden;" {{ block.shopify_attributes }}>
          <summary style="padding: 14px 18px; cursor: pointer; font-weight: 600; color: var(--km-text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center; background: rgba(197,160,89,0.05);">
            {{ block.settings.question }}
            <span style="font-size: 1.2rem; color: var(--km-gold-dark);">+</span>
          </summary>
          <div style="padding: 14px 18px; color: var(--km-text-secondary); line-height: 1.7; font-size: 0.93rem; border-top: 1px solid rgba(197,160,89,0.15);">
            {{ block.settings.answer }}
          </div>
        </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif %}

    {%- comment %} ── Support CTA Card ── {%- endcomment %}
    {%- for block in section.blocks -%}
      {%- if block.type == 'support_cta' -%}
      <div class="km-policy-section-block" style="margin-top: 36px; padding: 28px 32px; background: linear-gradient(135deg, rgba(197,160,89,0.1), rgba(139,30,43,0.06)); border: 1px solid rgba(197,160,89,0.3); border-radius: 14px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; justify-content: space-between;" {{ block.shopify_attributes }}>
        <div>
          <strong style="font-size: 1.1rem; color: var(--km-text-primary); display: block; margin-bottom: 6px;">{{ block.settings.cta_heading | default: "Need Help with a Return?" }}</strong>
          <span style="color: var(--km-text-secondary); font-size: 0.9rem;">{{ block.settings.cta_subtext | default: "Our support team responds within 24 hours." }}</span>
        </div>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          {%- if block.settings.phone != blank %}
          <a href="tel:{{ block.settings.phone }}" style="background: var(--km-gold-primary, #C5A059); color: #1A1410; padding: 11px 22px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">📞 {{ block.settings.phone_label | default: "Call Us" }}</a>
          {%- endif %}
          {%- if block.settings.whatsapp != blank %}
          <a href="https://wa.me/{{ block.settings.whatsapp }}" target="_blank" rel="noopener noreferrer" style="background: #25D366; color: #fff; padding: 11px 22px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">💬 WhatsApp</a>
          {%- endif %}
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}

    {%- assign has_text_columns = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'text_column' -%}{%- assign has_text_columns = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_text_columns %}<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin:28px 0;">{%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'accordion' -%}
          <details class="km-faq-item" style="border:1px solid rgba(197,160,89,.25);border-radius:8px;margin:12px 0;" {{ block.shopify_attributes }}><summary style="padding:14px;cursor:pointer;font-weight:600;">{{ block.settings.title }}</summary><div style="padding:0 14px 14px;">{{ block.settings.content }}</div></details>
        {%- when 'text_column' -%}
          <article style="padding:20px;border:1px solid rgba(197,160,89,.2);border-radius:10px;" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2>{{ block.settings.content }}</article>
        {%- when 'contact_card' -%}
          <address style="padding:20px;border:1px solid rgba(197,160,89,.25);border-radius:10px;font-style:normal;" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2>{% if block.settings.email != blank %}<p><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></p>{% endif %}{% if block.settings.phone != blank %}<p><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></p>{% endif %}{% if block.settings.address != blank %}<p>{{ block.settings.address | newline_to_br }}</p>{% endif %}</address>
      {%- endcase -%}
    {%- endfor -%}
    {%- if has_text_columns %}</div>{%- endif %}

    {%- if page.content != blank %}
    <div class="km-page-content km-policy-section-block" style="color: var(--km-text-secondary); line-height: 1.85; font-size: {{ section.settings.body_size }}px; margin-top: 28px;">
      {{ page.content }}
    </div>
    {%- endif %}

  </div>
</section>

{% schema %}
{
  "name": "Returns Policy Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Max Container Width",
      "min": 680,
      "max": 1200,
      "step": 40,
      "default": 880,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Font Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "steps_heading",
      "label": "Return Steps Heading",
      "default": "Step-by-Step Return Process"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "eligibility_badge",
      "name": "Eligibility Badge",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "⏱️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Title",
          "default": "3-Day Claim Window"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Contact us within 3 days of delivery with an unboxing video."
        }
      ]
    },
    {
      "type": "return_step",
      "name": "Return Step",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step Title",
          "default": "Record Unboxing Video"
        },
        {
          "type": "textarea",
          "id": "step_detail",
          "label": "Step Details",
          "default": "Video proof is mandatory for all return claims to verify transit damage."
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Can I return a customised/engraved item?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "No. Personalised and engraved items are non-returnable unless there is a manufacturing defect."
        }
      ]
    },
    {
      "type": "support_cta",
      "name": "Support CTA Card",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "cta_heading",
          "label": "Heading",
          "default": "Need Help with a Return?"
        },
        {
          "type": "text",
          "id": "cta_subtext",
          "label": "Subtext",
          "default": "Our support team responds within 24 hours."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Number (tel: link)",
          "default": "+917508427731"
        },
        {
          "type": "text",
          "id": "phone_label",
          "label": "Phone Button Label",
          "default": "Call Us"
        },
        {
          "type": "text",
          "id": "whatsapp",
          "label": "WhatsApp Number (digits only)",
          "default": "917508427731"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Frequently asked question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your answer here.</p>"
        }
      ]
    },
    {
      "type": "text_column",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Helpful information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add details here.</p>"
        }
      ]
    },
    {
      "type": "contact_card",
      "name": "Contact card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Contact us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "sales@kraftmart.shop"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+917508427731"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Amritsar, Punjab, India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Returns Policy Page",
      "blocks": [
        {
          "type": "eligibility_badge",
          "settings": {
            "icon": "⏱️",
            "title": "3-Day Claim Window",
            "description": "Contact us within 3 days of delivery with an unboxing video."
          }
        },
        {
          "type": "eligibility_badge",
          "settings": {
            "icon": "🛡️",
            "title": "Defect Protection",
            "description": "Immediate resolution or replacement for any verified transit damage."
          }
        },
        {
          "type": "return_step",
          "settings": {
            "step_title": "Record Unboxing Video",
            "step_detail": "Video proof is mandatory for all return claims."
          }
        },
        {
          "type": "return_step",
          "settings": {
            "step_title": "Contact Us Within 3 Days",
            "step_detail": "WhatsApp or email us at sales@kraftmart.shop with order ID and video."
          }
        },
        {
          "type": "return_step",
          "settings": {
            "step_title": "Await Resolution",
            "step_detail": "Our team reviews and responds within 24–48 hours with next steps."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I return a customised/engraved item?",
            "answer": "No. Personalised items are non-returnable unless there is a manufacturing defect."
          }
        },
        {
          "type": "support_cta",
          "settings": {
            "cta_heading": "Need Help with a Return?",
            "phone": "+917508427731",
            "whatsapp": "917508427731"
          }
        }
      ]
    }
  ]
}
{% endschema %}
