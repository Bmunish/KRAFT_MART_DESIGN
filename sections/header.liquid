<!-- Header Navigation -->
<header class="km-header">
  <div class="km-container">
    <div class="km-header-inner">
      <a href="{{ routes.root_url }}" class="km-header-logo">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-hairline);" />
        {% else %}
          <img src="{{ 'logo.jpeg' | asset_url }}" alt="KraftMart Logo" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-hairline);" />
        {% endif %}
        <span style="color: var(--color-ink-navy); font-weight: 700;">Kraft<span style="color: var(--km-gold-primary);">Mart</span></span>
      </a>

      <nav class="km-desktop-nav" aria-label="Main Navigation">
        <ul class="km-nav-list">
          <li><a href="{{ routes.root_url }}" class="km-nav-link {% if request.page_type == 'index' %}active{% endif %}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="km-nav-link {% if request.page_type == 'collection' %}active{% endif %}">Products</a></li>
          <li><a href="/pages/wedding-swords" class="km-nav-link">Wedding Swords</a></li>
          <li><a href="/pages/about" class="km-nav-link {% if request.path contains '/pages/about' %}active{% endif %}">About Us</a></li>
          <li><a href="{{ routes.all_blogs_url | default: '/blogs' }}" class="km-nav-link {% if request.page_type == 'blog' or request.page_type == 'article' %}active{% endif %}">Blogs</a></li>
          <li><a href="/pages/contact" class="km-nav-link {% if request.path contains '/pages/contact' %}active{% endif %}">Contact</a></li>

          <!-- Policy Dropdown Menu -->
          <li class="km-nav-item km-has-dropdown">
            <a href="#" class="km-nav-link km-dropdown-toggle">
              Our Policies <span class="km-dropdown-arrow">▾</span>
            </a>
            <div class="km-policy-dropdown">
              <ul class="km-policy-dropdown-list">
                <li><a href="/pages/shipping-policy" class="km-policy-link">SHIPPING POLICY</a></li>
                <li><a href="/pages/processing-time" class="km-policy-link">PROCESSING TIME POLICY</a></li>
                <li><a href="/pages/privacy-policy" class="km-policy-link">PRIVACY POLICY</a></li>
                <li><a href="/pages/return-policy" class="km-policy-link">RETURNS AND REFUNDS</a></li>
                <li><a href="/pages/contact" class="km-policy-link">CONTACT US</a></li>
              </ul>
            </div>
          </li>
        </ul>
      </nav>

      <div class="km-header-actions">
        <button class="km-icon-btn" id="kmSearchBtn" aria-label="Search">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <a href="{{ routes.cart_url }}" class="km-icon-btn" data-action="open-cart" aria-label="Cart" style="text-decoration: none; color: inherit;">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="km-cart-badge">{{ cart.item_count }}</span>
        </a>
        <!-- Mobile Hamburger -->
        <button class="km-icon-btn km-mobile-menu-btn" id="kmMobileMenuBtn" aria-label="Menu" style="display: none;">
          <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Nav Drawer -->
<div id="kmMobileNav" class="km-mobile-nav-overlay" aria-hidden="true">
  <div class="km-mobile-nav-backdrop" id="kmMobileNavBackdrop"></div>
  <nav class="km-mobile-nav-panel" aria-label="Mobile Navigation">
    <div class="km-mobile-nav-header">
      <span style="font-weight: 700; font-size: 1.1rem;">Kraft<span style="color: var(--km-gold-primary);">Mart</span></span>
      <button id="kmMobileNavClose" class="km-icon-btn" aria-label="Close menu">&#10005;</button>
    </div>
    <ul class="km-mobile-nav-list">
      <li><a href="{{ routes.root_url }}" class="km-mobile-nav-link">Home</a></li>
      <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="km-mobile-nav-link">Products</a></li>
      <li><a href="/pages/wedding-swords" class="km-mobile-nav-link">Wedding Swords</a></li>
      <li><a href="/pages/about" class="km-mobile-nav-link">About Us</a></li>
      <li><a href="{{ routes.all_blogs_url | default: '/blogs' }}" class="km-mobile-nav-link">Blogs</a></li>
      <li><a href="/pages/contact" class="km-mobile-nav-link">Contact</a></li>
      <li style="border-top: 1px solid rgba(197,160,89,0.2); margin-top: 12px; padding-top: 12px;">
        <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--km-gold-primary); font-weight: 600; padding: 0 20px; display: block; margin-bottom: 8px;">Our Policies</span>
      </li>
      <li><a href="/pages/shipping-policy" class="km-mobile-nav-link" style="font-size: 0.875rem;">Shipping Policy</a></li>
      <li><a href="/pages/processing-time" class="km-mobile-nav-link" style="font-size: 0.875rem;">Processing Time Policy</a></li>
      <li><a href="/pages/privacy-policy" class="km-mobile-nav-link" style="font-size: 0.875rem;">Privacy Policy</a></li>
      <li><a href="/pages/return-policy" class="km-mobile-nav-link" style="font-size: 0.875rem;">Returns &amp; Refunds</a></li>
    </ul>
  </nav>
</div>

<style>
  /* Mobile nav styles */
  @media (max-width: 900px) {
    .km-desktop-nav { display: none !important; }
    .km-mobile-menu-btn { display: flex !important; }
  }
  .km-mobile-nav-overlay {
    position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0; transition: opacity 0.25s;
  }
  .km-mobile-nav-overlay.is-open {
    pointer-events: all; opacity: 1;
  }
  .km-mobile-nav-backdrop {
    position: absolute; inset: 0; background: rgba(10,10,10,0.7); backdrop-filter: blur(4px);
  }
  .km-mobile-nav-panel {
    position: absolute; top: 0; right: 0; width: min(320px, 90vw); height: 100vh;
    background: var(--color-cloud, #FAF7F2); overflow-y: auto;
    transform: translateX(100%); transition: transform 0.3s cubic-bezier(.4,0,.2,1);
    box-shadow: -8px 0 40px rgba(0,0,0,0.3);
  }
  .km-mobile-nav-overlay.is-open .km-mobile-nav-panel { transform: translateX(0); }
  .km-mobile-nav-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px; border-bottom: 1px solid rgba(197,160,89,0.2);
  }
  .km-mobile-nav-list { list-style: none; margin: 0; padding: 12px 0; }
  .km-mobile-nav-link {
    display: block; padding: 14px 20px; color: var(--color-ink-navy, #1a2744);
    font-weight: 500; text-decoration: none; font-size: 1rem;
    transition: background 0.15s, color 0.15s;
  }
  .km-mobile-nav-link:hover { background: rgba(197,160,89,0.1); color: var(--km-gold-primary, #C5A059); }
</style>

<script>
  // Mobile nav toggle
  (function() {
    var btn = document.getElementById('kmMobileMenuBtn');
    var nav = document.getElementById('kmMobileNav');
    var close = document.getElementById('kmMobileNavClose');
    var backdrop = document.getElementById('kmMobileNavBackdrop');
    function open() { nav.classList.add('is-open'); nav.setAttribute('aria-hidden','false'); }
    function closeNav() { nav.classList.remove('is-open'); nav.setAttribute('aria-hidden','true'); }
    if (btn) btn.addEventListener('click', open);
    if (close) close.addEventListener('click', closeNav);
    if (backdrop) backdrop.addEventListener('click', closeNav);
  })();
  // Search button wire-up
  var searchBtn = document.getElementById('kmSearchBtn');
  if (searchBtn) {
    searchBtn.addEventListener('click', function() {
      var overlay = document.getElementById('kmSearchOverlay');
      if (overlay) { overlay.classList.add('is-open'); var inp = document.getElementById('kmSearchInput'); if(inp) inp.focus(); }
    });
  }
</script>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "header",
      "content": "Top Utility Bar"
    },
    {
      "type": "text",
      "id": "helpline_label",
      "label": "Helpline Label",
      "default": "Helpline Number:"
    },
    {
      "type": "text",
      "id": "helpline_phone",
      "label": "Phone Number",
      "default": "+91-75084-27731"
    },
    {
      "type": "text",
      "id": "google_rating",
      "label": "Google Rating Badge",
      "default": "4.9 ★"
    },
    {
      "type": "url",
      "id": "google_url",
      "label": "Google Business Link"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_1",
      "label": "Message 1",
      "default": "Our USP: Affordable swords at your doorstep with a pinch of customisation"
    },
    {
      "type": "text",
      "id": "announcement_2",
      "label": "Message 2",
      "default": "Cash on Delivery Available in India"
    },
    {
      "type": "text",
      "id": "announcement_3",
      "label": "Message 3",
      "default": "Free Custom Engraving on All Orders"
    },
    {
      "type": "text",
      "id": "announcement_4",
      "label": "Message 4",
      "default": "Worldwide Shipping via FedEx & DHL"
    },
    {
      "type": "text",
      "id": "announcement_5",
      "label": "Message 5",
      "default": "Handcrafted in Amritsar, Punjab Since 1996"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu"
    }
  ]
}
{% endschema %}
