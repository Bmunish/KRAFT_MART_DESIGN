
<!-- Top Utility Bar: Helpline & Country/Currency Switcher -->
<div class="km-top-utility-bar">
  <div class="km-container km-top-utility-inner">
    <div class="km-top-utility-left">
      <span class="km-helpline-label">{{ section.settings.helpline_label | default: "Helpline Number:" }}</span>
      <a href="tel:{{ section.settings.helpline_phone | default: '+917508427731' }}" class="km-helpline-num">{{ section.settings.helpline_phone | default: "+91-75084-27731" }}</a>
      <span style="opacity: 0.35; margin: 0 8px; color: #FAF7F2;">|</span>
      <a href="{{ section.settings.google_url | default: 'https://www.google.com/search?sca_esv=9690ff17f276db6e&rlz=1C1FHFK_enIN1105IN1105&sxsrf=APpeQnuC7VLyucK3RXEanRReOrH--HBCyw:1790882647447&kgmid=/g/11q2rz95sv&q=Lakshmi+Engineering+Works+A.K.A+Kraftmart.shop' }}" target="_blank" rel="noopener noreferrer" class="km-google-rating-pill" title="View KraftMart on Google Business" style="display: inline-flex; align-items: center; gap: 5px; color: #FAF7F2; text-decoration: none; font-size: 0.72rem; padding: 2px 8px; border-radius: 12px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(197, 160, 89, 0.4);">
        <svg width="12" height="12" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg>
        <span style="font-weight: 700; color: #FFD700;">{{ section.settings.google_rating | default: "4.9 ★" }}</span>
        <span style="color: rgba(250,247,242,0.85);">Google Business</span>
      </a>
    </div>
    <div class="km-top-utility-right">
      <div class="km-currency-selector-widget" id="kmCurrencyWidget">
        <button type="button" class="km-currency-trigger" id="kmCurrencyTrigger" aria-haspopup="true" aria-expanded="false" title="Select Country &amp; Currency">
          <span class="km-trigger-text" id="kmTriggerText">India | INR ₹</span>
          <span class="km-trigger-chevron">⌵</span>
        </button>
        <div class="km-currency-menu" id="kmCurrencyMenu" role="menu">
          <div class="km-currency-menu-title">Select Shipping Destination</div>
          <div class="km-currency-options">
            <button type="button" class="km-currency-opt is-active" data-country="India" data-currency="INR" data-symbol="₹" data-label="India | INR ₹">
              <span class="km-opt-flag">🇮🇳</span>
              <span class="km-opt-name">India</span>
              <span class="km-opt-badge">INR (₹)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="United States" data-currency="USD" data-symbol="$" data-label="United States | USD $">
              <span class="km-opt-flag">🇺🇸</span>
              <span class="km-opt-name">United States</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="United Kingdom" data-currency="USD" data-symbol="$" data-label="United Kingdom | USD $">
              <span class="km-opt-flag">🇬🇧</span>
              <span class="km-opt-name">United Kingdom</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="Canada" data-currency="USD" data-symbol="$" data-label="Canada | USD $">
              <span class="km-opt-flag">🇨🇦</span>
              <span class="km-opt-name">Canada</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="Australia" data-currency="USD" data-symbol="$" data-label="Australia | USD $">
              <span class="km-opt-flag">🇦🇺</span>
              <span class="km-opt-name">Australia</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="United Arab Emirates" data-currency="USD" data-symbol="$" data-label="UAE | USD $">
              <span class="km-opt-flag">🇦🇪</span>
              <span class="km-opt-name">United Arab Emirates</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="Europe" data-currency="USD" data-symbol="$" data-label="Europe | USD $">
              <span class="km-opt-flag">🇪🇺</span>
              <span class="km-opt-name">Europe (EU)</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
            <button type="button" class="km-currency-opt" data-country="Rest of World" data-currency="USD" data-symbol="$" data-label="International | USD $">
              <span class="km-opt-flag">🌐</span>
              <span class="km-opt-name">Rest of World</span>
              <span class="km-opt-badge">USD ($)</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

