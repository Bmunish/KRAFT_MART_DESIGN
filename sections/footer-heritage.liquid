{% comment %}
  KRAFTMART — EDITORIAL HERITAGE FOOTER SECTION
  Multicolumn footer with newsletter, policies, country/currency selector & payment badges
{% endcomment %}

<footer class="km-footer">
  <div class="km-container">
    <div class="km-footer-grid">
      <!-- Brand & Newsletter -->
      <div class="km-footer-brand">
        <a href="/" class="km-header-logo" style="color: #FFF; margin-bottom: 16px;">
          <img src="{{ 'logo.jpeg' | asset_url }}" alt="{{ shop.name }}" style="height: 44px; width: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--color-ld-steel);" />
          <span>Kraft<span style="color: var(--km-gold-primary);">Mart</span></span>
        </a>
        <p>
          Handcrafted Indian wedding swords, Rajput talwars, and Sikh ceremonial heritage objects forged in Amritsar, Punjab since 1996.
        </p>

        <!-- Newsletter Subscription Form -->
        <form method="post" action="/contact#contact_form" style="display: flex; gap: 8px; max-width: 380px;">
          <input type="hidden" name="form_type" value="customer" />
          <input type="email" name="contact[email]" placeholder="Enter your email address" required style="background: rgba(255,255,255,0.08); border: var(--km-border-dark); padding: 12px 16px; border-radius: var(--km-radius-sm); color: #FFF; width: 100%; font-size: 0.875rem;" />
          <button type="submit" class="km-btn km-btn-gold" style="padding: 12px 20px; white-space: nowrap;">
            Subscribe
          </button>
        </form>
      </div>

      <!-- Footer Column 1: Navigation -->
      <div>
        <h4 class="km-footer-title">Quick Links</h4>
        <ul class="km-footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/collections/wedding-swords">Wedding Swords</a></li>
          <li><a href="/pages/about-us">About KraftMart</a></li>
          <li><a href="/blogs/news">Heritage Blogs</a></li>
        </ul>
      </div>

      <!-- Footer Column 2: Legal & Policies -->
      <div>
        <h4 class="km-footer-title">Our Policies</h4>
        <ul class="km-footer-links">
          <li><a href="/policies/shipping-policy">Shipping & Delivery</a></li>
          <li><a href="/policies/refund-policy">Refund & Return Policy</a></li>
          <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Footer Column 3: Contact & Support -->
      <div>
        <h4 class="km-footer-title">Connect With Us</h4>
        <ul class="km-footer-links">
          <li><span>📍 Amritsar, Punjab, India</span></li>
          <li><span>📧 support@kraftmart.shop</span></li>
          <li><span>💬 WhatsApp COD Support</span></li>
          <li><span>✈️ FedEx & DHL Express Shipping</span></li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom Bar -->
    <div class="km-footer-bottom">
      <div>
        © {{ 'now' | date: "%Y" }} KraftMart. All Rights Reserved. Handcrafted with pride in Amritsar, India.
      </div>
      <div style="display: flex; gap: 16px; align-items: center;">
        <span>COD Available</span> •
        <span>Worldwide Shipping</span> •
        <span>Free Engraving</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Heritage Footer",
  "settings": [],
  "presets": [
    {
      "name": "Heritage Footer",
      "category": "Footer"
    }
  ]
}
{% endschema %}
