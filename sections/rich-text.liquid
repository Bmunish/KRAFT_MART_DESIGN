<section style="padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;background:{{ section.settings.background_color }};text-align:{{ section.settings.alignment }};">
  <div style="max-width:800px;margin:0 auto;">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    <div>{{ section.settings.text }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little about KraftMart" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Discover handcrafted heritage pieces made with care in Amritsar.</p>" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FAF7F2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "default": 48, "unit": "px" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
