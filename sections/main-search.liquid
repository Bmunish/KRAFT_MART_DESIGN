<section class="km-section" style="padding: 96px 0;">
  <div class="km-container">
    <div style="text-align: center; margin-bottom: 48px;">
      <h1 class="km-heading-hero" style="font-size: 2.5rem; margin-bottom: 16px;">Search Results</h1>
      
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 500px; margin: 0 auto; position: relative;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." style="width: 100%; padding: 14px 24px; border-radius: 30px; border: 1px solid var(--km-border-gold); background: var(--km-bg-secondary); color: var(--km-text-primary); font-family: var(--km-font-body); outline: none;">
        <button type="submit" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: var(--km-gold-primary); color: #fff; border: none; border-radius: 20px; padding: 8px 16px; cursor: pointer; font-weight: 600;">Search</button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div style="text-align: center; padding: 40px 0; color: var(--km-text-secondary);">
          <p>No results found for "{{ search.terms | escape }}". Try checking your spelling or using different keywords.</p>
        </div>
      {% else %}
        <div style="text-align: center; margin-bottom: 32px; color: var(--km-text-secondary);">
          <p>Showing {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms | escape }}"</p>
        </div>
        
        <div class="km-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px;">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              <a href="{{ item.url }}" style="text-decoration: none; display: block; background: var(--km-bg-secondary); border-radius: 12px; overflow: hidden; border: 1px solid rgba(197, 160, 89, 0.15); transition: transform 0.3s ease;">
                <div style="aspect-ratio: 1; background: #fff; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                  <img src="{{ item.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ item.title | escape }}" width="600" height="600" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <div style="padding: 20px;">
                  <h3 style="font-family: var(--km-font-heading); font-size: 1.1rem; color: var(--km-text-primary); margin: 0 0 8px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ item.title }}</h3>
                  <div style="color: var(--km-gold-dark); font-weight: 600;">
                    {% if item.price_varies %}From {% endif %}{{ item.price | money }}
                  </div>
                </div>
              </a>
            {% else %}
              <a href="{{ item.url }}" style="text-decoration: none; display: flex; flex-direction: column; justify-content: center; padding: 32px; background: var(--km-bg-secondary); border-radius: 12px; border: 1px solid rgba(197, 160, 89, 0.15);">
                <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-primary); margin-bottom: 8px;">{{ item.object_type | capitalize }}</div>
                <h3 style="font-family: var(--km-font-heading); font-size: 1.2rem; color: var(--km-text-primary); margin: 0 0 12px 0;">{{ item.title }}</h3>
                <p style="color: var(--km-text-secondary); font-size: 0.9rem; margin: 0; line-height: 1.5;">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": [],
  "presets": [
    {
      "name": "Search Results"
    }
  ]
}
{% endschema %}
