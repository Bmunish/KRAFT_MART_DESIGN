    },
    {
      "type": "header",
      "content": "Partner 2"
    },
    {
      "type": "text",
      "id": "partner_2_name",
      "label": "Partner 2 Name",
      "default": "DHL Express"
    },
    {
      "type": "text",
      "id": "partner_2_sub",
      "label": "Partner 2 Subtitle",
      "default": "2–5 days · Worldwide Express"
    },
    {
      "type": "header",
      "content": "Partner 3"
    },
    {
      "type": "text",
      "id": "partner_3_name",
      "label": "Partner 3 Name",
      "default": "India Post Speed Post"
    },
    {
      "type": "text",
      "id": "partner_3_sub",
      "label": "Partner 3 Subtitle",
