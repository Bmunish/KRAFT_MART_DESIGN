<section class="km-section" style="padding: 64px 0 80px; background: var(--km-bg-main, #fcfbf9);">
  <div class="km-container">
    <div class="km-policy-page-wrap km-reveal">
        
        <!-- Tabbed Policy Navigation Strip -->
        <div class="km-policy-nav-strip">
          <a href="/pages/shipping-policy" class="km-policy-tab-link">🚚 Shipping Policy</a>
          <a href="/pages/processing-time" class="km-policy-tab-link">⏱️ Processing Time</a>
          <a href="/pages/return-policy" class="km-policy-tab-link active">↩ Returns &amp; Refunds</a>
          <a href="/pages/privacy-policy" class="km-policy-tab-link">🔒 Privacy Policy</a>
          <a href="/pages/contact" class="km-policy-tab-link">✉ Contact Us</a>
        </div>

        <!-- 3 Feature Highlight Cards -->
        <div class="km-policy-feature-grid">
          <div class="km-policy-feature-card">
            <div class="km-policy-feature-icon">⏱️</div>
            <div>
              <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ section.settings.feat_1_title | default: "3-Day Claim Window" }}</strong>
              <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ section.settings.feat_1_desc | default: "Notify us within 3 days of delivery with your unboxing video." }}</span>
            </div>
          </div>

          <div class="km-policy-feature-card">
            <div class="km-policy-feature-icon">🛡️</div>
            <div>
              <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ section.settings.feat_2_title | default: "Defect Protection" }}</strong>
              <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ section.settings.feat_2_desc | default: "Immediate resolution or replacement for any verified transit damage." }}</span>
            </div>
          </div>

          <div class="km-policy-feature-card">
            <div class="km-policy-feature-icon">🤝</div>
            <div>
              <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ section.settings.feat_3_title | default: "Amicable Solutions" }}</strong>
              <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ section.settings.feat_3_desc | default: "Dedicated support team to address your concerns with care." }}</span>
            </div>
          </div>
        </div>

        <!-- Section 1: Overview -->
        <div class="km-policy-section-block">
          <p>
            {{ section.settings.overview_1 | default: "At Lakshmi Engineering Works, we take great pride in our handcrafted products. However, due to the customized nature of our swords, daggers, and handicrafts, we do not accept returns or refunds for international orders." }}
          </p>
          <p>
            {{ section.settings.overview_2 | default: "If you face any issue with your order, we encourage you to reach out to us, and we will work together to resolve your concerns amicably." }}
          </p>
        </div>

        <!-- Section 2: Terms Breakdown -->
        <div class="km-policy-section-block">
          <h2><span>🚫</span> Return &amp; Refund Terms</h2>
          
          <h3 style="font-family: var(--km-font-heading); font-size: 1.15rem; color: var(--km-text-primary); margin: 20px 0 10px;">
            🌏 For International Orders (Exports):
          </h3>
          <ul class="km-policy-list">
            <li><strong>No returns or refunds are accepted</strong> once exported due to strict international cross-border logistics and customs regulations.</li>
            <li>In exceptional cases where a return is agreed upon after mutual discussion with our management, <strong>the buyer must bear all return shipping costs, customs duties, and taxes</strong>.</li>
          </ul>

          <h3 style="font-family: var(--km-font-heading); font-size: 1.15rem; color: var(--km-text-primary); margin: 20px 0 10px;">
            🇮🇳 For Domestic (India) Orders:
          </h3>
          <ul class="km-policy-list">
            <li>Returns are <strong>allowed only for defective, damaged, or incorrect items</strong> delivered.</li>
            <li>In such cases, the buyer must share clear unboxing proof, and the return request must be pre-approved by our support team.</li>
            <li>All return requests must be raised within the valid 3-day window from receipt.</li>
          </ul>
        </div>

        <!-- 4 Steps Return Process -->
        <div class="km-policy-section-block">
          <h2><span>⚙️</span> The Return &amp; Resolution Process</h2>
          <div class="km-steps-timeline">
            <div class="km-step-item">
              <div class="km-step-num">1</div>
              <strong style="display: block; font-size: 0.88rem; color: var(--km-text-primary); margin-bottom: 6px;">Report Issue</strong>
              <p style="font-size: 0.8rem; color: var(--km-text-secondary); line-height: 1.4; margin: 0;">Contact us within <strong>3 days</strong> of package arrival.</p>
            </div>

            <div class="km-step-item">
              <div class="km-step-num">2</div>
              <strong style="display: block; font-size: 0.88rem; color: var(--km-text-primary); margin-bottom: 6px;">Share Proof</strong>
              <p style="font-size: 0.8rem; color: var(--km-text-secondary); line-height: 1.4; margin: 0;">Provide Order ID, clear unboxing video &amp; damage photos.</p>
            </div>

            <div class="km-step-item">
              <div class="km-step-num">3</div>
              <strong style="display: block; font-size: 0.88rem; color: var(--km-text-primary); margin-bottom: 6px;">Team Review</strong>
              <p style="font-size: 0.8rem; color: var(--km-text-secondary); line-height: 1.4; margin: 0;">Our master workshop reviews and verifies claim within 24h.</p>
            </div>

            <div class="km-step-item">
              <div class="km-step-num">4</div>
              <strong style="display: block; font-size: 0.88rem; color: var(--km-text-primary); margin-bottom: 6px;">Resolution</strong>
              <p style="font-size: 0.8rem; color: var(--km-text-secondary); line-height: 1.4; margin: 0;">Approved claims receive replacement or repair dispatch.</p>
            </div>
          </div>
        </div>

        <!-- Custom Engraving Notice -->
        <div class="km-policy-notice-box">
          <div style="font-family: var(--km-font-display); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--km-crimson-primary); margin-bottom: 8px;">
            ⚠️ Custom Engraved &amp; Bespoke Articles
          </div>
          <p style="color: var(--km-text-primary); font-size: 0.92rem; line-height: 1.7; margin: 0;">
            {{ section.settings.engraving_notice | default: "Blades and handicrafts with personalized laser engraving (such as bride & groom names, dates, or holy scripture) cannot be returned or resold. Please ensure all spelling and dates submitted during order checkout are 100% accurate." }}
          </p>
        </div>

        <!-- Contact Support -->
        <div class="km-policy-section-block">
          <h2><span>💬</span> Need Support With Your Order?</h2>
          <p>
            Contact our dedicated support desk directly. We respond to all WhatsApp messages and emails within hours:
          </p>
          <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 18px;">
            <a href="https://wa.me/{{ section.settings.whatsapp_digits | default: '917508427731' }}" class="km-btn km-btn-primary" style="padding: 12px 24px; font-size: 0.88rem;">📱 WhatsApp: {{ section.settings.support_phone | default: "+91-75084-27731" }}</a>
            <a href="mailto:{{ section.settings.support_email | default: 'kraftengineering2024@gmail.com' }}" class="km-btn km-btn-outline" style="padding: 12px 24px; font-size: 0.88rem;">✉ {{ section.settings.support_email | default: "kraftengineering2024@gmail.com" }}</a>
          </div>
        </div>

      </div>

    </div>
  </section>

