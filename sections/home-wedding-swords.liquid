<!-- Section: Wedding Campaign & Live Engraving Simulator (The Groom's Heritage) -->
  <section id="wedding-swords" class="km-section km-wedding-heritage-section">
    <div class="km-container" style="position: relative; z-index: 1;">
      <div class="km-wedding-grid">
        <div class="km-wedding-content">
          <span class="km-eyebrow" style="color: var(--km-gold-primary); letter-spacing: 0.15em;">THE GROOM'S HERITAGE</span>
          <h2 class="km-heading-1 km-wedding-title" style="margin-bottom: 20px;">Honor Tradition on Your Special Day</h2>
          <p class="km-body-lead" style="color: var(--km-text-muted-light); margin-bottom: 28px; line-height: 1.7;">
            In Indian wedding culture, a groom carrying a ceremonial sword symbolizes protection, royal lineage, and
            honor. Our wedding talwars feature velvet-sheathed scabbards, hand-engraved brass hilts, and personalized
            blade inscriptions.
          </p>

          <!-- Interactive Live Engraving Preview: Heritage Parchment Styling -->
          <div class="km-engraving-simulator-card">
            <div class="km-engraving-card-header">
              <span class="km-engraving-badge">&#10022; Free Custom Laser Engraving Simulator</span>
            </div>
            <p style="font-size: 0.8125rem; color: var(--km-text-muted-light); margin-bottom: 12px;">
              Type Bride &amp; Groom names below to simulate live blade laser inscription:
            </p>
            <input type="text" id="kmEngravingInput" class="km-engraving-input"
              value="Gurpreet ❤️ Simran • 24.10.2026"
              placeholder="e.g. Gurpreet ❤️ Simran • 24.10.2026" />
            
            <div class="km-engraving-preset-chips">
              <span style="font-size: 0.72rem; color: var(--km-text-muted-light); margin-right: 4px;">Presets:</span>
              <button type="button" class="km-engraving-chip active" data-preset="Gurpreet ❤️ Simran • 24.10.2026">Gurpreet ❤️ Simran</button>
              <button type="button" class="km-engraving-chip" data-preset="Rajveer Singh • 2026">Rajveer Singh</button>
              <button type="button" class="km-engraving-chip" data-preset="Harman & Navjot • Forever">Harman &amp; Navjot</button>
            </div>

            <div class="km-engraving-preview-box">
              <span class="km-engraving-preview-label">Blade Inscription Preview</span>
              <div class="km-engraving-preview-text" id="kmEngravingPreviewText">&ldquo;Gurpreet ❤️ Simran • 24.10.2026&rdquo;</div>
              <div class="km-engraving-laser-shine" aria-hidden="true"></div>
            </div>
          </div>

          <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
            <a href="/collections/wedding-swords" class="km-btn km-btn-primary" style="padding: 14px 32px;">Shop Wedding Talwars &rarr;</a>
            <span style="font-size: 0.85rem; color: var(--km-gold-light); display: inline-flex; align-items: center; gap: 6px;">
              <span>✓</span> Free Laser Engraving Included
            </span>
          </div>
        </div>

        <div class="km-wedding-visual">
          <div class="km-wedding-glow-backdrop" aria-hidden="true"></div>
          <div class="km-wedding-image-wrapper">
            <img src="{{ 'hero_talwar.png' | asset_url }}" alt="KraftMart Groom Wedding Talwar with Royal Red Velvet Scabbard" class="km-wedding-sword-img" decoding="async" loading="lazy" />
          </div>
          <div class="km-wedding-floating-tag">
            <span class="km-tag-icon">&#10022;</span>
            <div>
              <strong>Master Handcrafted in Amritsar</strong>
              <span>Solid Brass Kundan Hilt &bull; Velvet Sheath</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


{% schema %}
{
  "name": "Wedding Swords",
  "settings": [],
  "presets": [
    {
      "name": "Wedding Swords"
    }
  ]
}
{% endschema %}
