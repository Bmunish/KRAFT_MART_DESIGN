<!-- Section: Wedding Campaign & Live Engraving Simulator (The Groom's Heritage) -->
<section id="wedding-swords" class="km-section km-wedding-heritage-section">
  <div class="km-container" style="position: relative; z-index: 1;">
    <div class="km-wedding-grid">
      <div class="km-wedding-content">
        <span class="km-eyebrow" style="color: var(--km-gold-primary); letter-spacing: 0.15em;">{{ section.settings.eyebrow | default: "THE GROOM'S HERITAGE" }}</span>
        <h2 class="km-heading-1 km-wedding-title" style="margin-bottom: 20px;">{{ section.settings.title | default: "Honor Tradition on Your Special Day" }}</h2>
        <p class="km-body-lead" style="color: var(--km-text-muted-light); margin-bottom: 28px; line-height: 1.7;">
          {{ section.settings.description | default: "In Indian wedding culture, a groom carrying a ceremonial sword symbolizes protection, royal lineage, and honor. Our wedding talwars feature velvet-sheathed scabbards, hand-engraved brass hilts, and personalized blade inscriptions." }}
        </p>

        <!-- Interactive Live Engraving Preview: Heritage Parchment Styling -->
        <div class="km-engraving-simulator-card">
          <div class="km-engraving-card-header">
            <span class="km-engraving-badge">&#10022; {{ section.settings.engraving_badge | default: "Free Custom Laser Engraving Simulator" }}</span>
          </div>
          <p style="font-size: 0.8125rem; color: var(--km-text-muted-light); margin-bottom: 12px;">
            {{ section.settings.engraving_instruction | default: "Type Bride &amp; Groom names below to simulate live blade laser inscription:" }}
          </p>
          <input type="text" id="kmEngravingInput" class="km-engraving-input"
            value="{{ section.settings.engraving_default | default: 'Gurpreet ❤️ Simran • 24.10.2026' }}"
            placeholder="{{ section.settings.engraving_placeholder | default: 'e.g. Gurpreet ❤️ Simran • 24.10.2026' }}" />

          <div class="km-engraving-preset-chips">
            <span style="font-size: 0.72rem; color: var(--km-text-muted-light); margin-right: 4px;">Presets:</span>
            <button type="button" class="km-engraving-chip active" data-preset="{{ section.settings.preset_1 | default: 'Gurpreet ❤️ Simran • 24.10.2026' }}">{{ section.settings.preset_1_label | default: "Gurpreet ❤️ Simran" }}</button>
            <button type="button" class="km-engraving-chip" data-preset="{{ section.settings.preset_2 | default: 'Rajveer Singh • 2026' }}">{{ section.settings.preset_2_label | default: "Rajveer Singh" }}</button>
            <button type="button" class="km-engraving-chip" data-preset="{{ section.settings.preset_3 | default: 'Harman & Navjot • Forever' }}">{{ section.settings.preset_3_label | default: "Harman &amp; Navjot" }}</button>
          </div>

          <div class="km-engraving-preview-box">
            <span class="km-engraving-preview-label">{{ section.settings.preview_label | default: "Blade Inscription Preview" }}</span>
            <div class="km-engraving-preview-text" id="kmEngravingPreviewText">&ldquo;{{ section.settings.engraving_default | default: 'Gurpreet ❤️ Simran • 24.10.2026' }}&rdquo;</div>
            <div class="km-engraving-laser-shine" aria-hidden="true"></div>
          </div>
        </div>

        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
          <a href="{{ section.settings.button_link | default: '/collections/wedding-swords' }}" class="km-btn km-btn-primary" style="padding: 14px 32px;">
            {{ section.settings.button_label | default: "Shop Wedding Talwars →" }}
          </a>
          <span style="font-size: 0.85rem; color: var(--km-gold-light); display: inline-flex; align-items: center; gap: 6px;">
            <span>✓</span> {{ section.settings.perk_text | default: "Free Laser Engraving Included" }}
          </span>
        </div>
      </div>

      <div class="km-wedding-visual">
        <div class="km-wedding-glow-backdrop" aria-hidden="true"></div>
        <div class="km-wedding-image-wrapper">
          {% assign default_wedding_img = 'hero_talwar.png' | asset_url %}
          <img src="{{ section.settings.image | default: default_wedding_img }}" alt="{{ section.settings.title | default: 'KraftMart Groom Wedding Talwar' | escape }}" class="km-wedding-sword-img" decoding="async" loading="lazy" />
        </div>
        <div class="km-wedding-floating-tag">
          <span class="km-tag-icon">&#10022;</span>
          <div>
            <strong>{{ section.settings.floating_title | default: "Master Handcrafted in Amritsar" }}</strong>
            <span>{{ section.settings.floating_subtitle | default: "Solid Brass Kundan Hilt • Velvet Sheath" }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

