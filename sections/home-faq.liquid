<!-- FAQ Section -->

  <section id="faq" class="km-section" style="background-color: var(--color-cloud);">
    <div class="km-container">
      <div class="km-section-header">
        <span class="km-eyebrow">HELP &amp; INFORMATION</span>
        <h2 class="km-heading-1" style="color: var(--color-ink-navy);">Frequently Asked Questions</h2>
      </div>

      <div class="km-faq-list">
        <div class="km-faq-item">
          <button class="km-faq-trigger">
            <span>Are decorative ceremonial swords legal to purchase and own?</span>
            <span class="km-faq-icon">▼</span>
          </button>
          <div class="km-faq-content">
            <p>Yes. All KraftMart ceremonial talwars and decorative swords are blunt, handcrafted objects created
              strictly for ceremonial, wedding, display, and cultural purposes. They comply with Indian legal standards
              and international customs regulations for decorative metalwork.</p>
          </div>
        </div>

        <div class="km-faq-item">
          <button class="km-faq-trigger">
            <span>How does Cash on Delivery (COD) work for Indian orders?</span>
            <span class="km-faq-icon">▼</span>
          </button>
          <div class="km-faq-content">
            <p>For orders within India, we offer a flexible Cash on Delivery option requiring a 15% advance booking
              amount at checkout to confirm your order, with the remaining 85% payable upon delivery. Customers choosing
              100% full advance payment receive an additional 5% instant discount.</p>
          </div>
        </div>

        <div class="km-faq-item">
          <button class="km-faq-trigger">
            <span>How do I request Free Custom Laser Engraving?</span>
            <span class="km-faq-icon">▼</span>
          </button>
          <div class="km-faq-content">
            <p>You can enter your desired text (names, wedding date, or special message) directly in the "Custom
              Engraving Notes" field inside your cart or at checkout. Our master craftsman will engrave your inscription
              prior to final polishing and dispatch.</p>
          </div>
        </div>

        <div class="km-faq-item">
          <button class="km-faq-trigger">
            <span>Do you ship internationally via FedEx &amp; DHL?</span>
            <span class="km-faq-icon">▼</span>
          </button>
          <div class="km-faq-content">
            <p>Yes! We ship worldwide to the USA, Canada, UK, Europe, Australia, UAE, and beyond via express courier
              services (FedEx and DHL Express). Full tracking details are emailed automatically upon dispatch.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


