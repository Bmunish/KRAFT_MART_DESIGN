{%- assign pad_top = section.settings.padding_top -%}
{%- assign pad_bot = section.settings.padding_bottom -%}

<section class="km-section km-page-shipping" style="padding: {{ pad_top }}px 0 {{ pad_bot }}px; background: {{ section.settings.bg_color }};">
  <div class="km-container" style="max-width: {{ section.settings.container_width }}px; margin: 0 auto; text-align: {{ section.settings.text_alignment }};">

    <div class="km-policy-nav-strip" style="margin-bottom: 32px;">
      <a href="/policies/shipping-policy" class="km-policy-tab-link active">🚚 Shipping</a>
      <a href="/pages/processing-time" class="km-policy-tab-link">⏱️ Processing</a>
      <a href="/policies/refund-policy" class="km-policy-tab-link">↩ Returns</a>
      <a href="/policies/privacy-policy" class="km-policy-tab-link">🔒 Privacy</a>
      <a href="/pages/contact" class="km-policy-tab-link">✉ Contact</a>
    </div>

    <h1 class="km-heading-1" style="font-size: {{ section.settings.title_size }}px; margin-bottom: 8px; color: var(--km-text-primary);">
      {{ page.title | default: "Shipping Policy" }}
    </h1>
    <div style="width: 56px; height: 3px; background: linear-gradient(90deg, var(--km-gold-primary), var(--km-gold-dark)); border-radius: 2px; margin-bottom: 28px;"></div>

    {%- comment %} ── Highlight Cards ── {%- endcomment %}
    {%- assign has_highlights = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'highlight_card' -%}{%- assign has_highlights = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_highlights %}
    <div class="km-policy-feature-grid" style="margin-bottom: 36px;">
      {%- for block in section.blocks -%}
        {%- if block.type == 'highlight_card' -%}
        <div class="km-policy-feature-card" {{ block.shopify_attributes }}>
          <div class="km-policy-feature-icon">{{ block.settings.icon }}</div>
          <div>
            <strong style="color: var(--km-text-primary); font-size: 0.95rem; display: block; margin-bottom: 4px;">{{ block.settings.title }}</strong>
            <span style="color: var(--km-text-secondary); font-size: 0.84rem; line-height: 1.4;">{{ block.settings.description }}</span>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif %}

    {%- comment %} ── Shipping Rates Table ── {%- endcomment %}
    {%- assign has_rates = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'rate_row' -%}{%- assign has_rates = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_rates %}
    <div class="km-policy-section-block" style="margin-bottom: 28px;">
      <h2><span>📦</span> Shipping Rates</h2>
      <div style="overflow-x: auto; margin-top: 14px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
          <thead>
            <tr style="background: rgba(197,160,89,0.12); text-align: left;">
              <th style="padding: 10px 14px; border-bottom: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary); font-weight: 700;">Zone</th>
              <th style="padding: 10px 14px; border-bottom: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary); font-weight: 700;">Method</th>
              <th style="padding: 10px 14px; border-bottom: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary); font-weight: 700;">Timeline</th>
              <th style="padding: 10px 14px; border-bottom: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary); font-weight: 700;">Rate</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'rate_row' -%}
              <tr {{ block.shopify_attributes }}>
                <td style="padding: 9px 14px; border-bottom: 1px solid rgba(0,0,0,0.06); color: var(--km-text-secondary);">{{ block.settings.zone }}</td>
                <td style="padding: 9px 14px; border-bottom: 1px solid rgba(0,0,0,0.06); color: var(--km-text-secondary);">{{ block.settings.method }}</td>
                <td style="padding: 9px 14px; border-bottom: 1px solid rgba(0,0,0,0.06); color: var(--km-text-secondary);">{{ block.settings.timeline }}</td>
                <td style="padding: 9px 14px; border-bottom: 1px solid rgba(0,0,0,0.06); font-weight: 600; color: var(--km-gold-dark);">{{ block.settings.rate }}</td>
              </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
    {%- endif %}

    {%- comment %} ── FAQ Accordion ── {%- endcomment %}
    {%- assign has_faq = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}{%- assign has_faq = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_faq %}
    <div class="km-policy-section-block" style="margin-bottom: 28px;">
      <h2><span>❓</span> Frequently Asked Questions</h2>
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' -%}
        <details class="km-faq-item" style="border: 1px solid rgba(197,160,89,0.2); border-radius: 8px; margin-top: 10px; overflow: hidden;" {{ block.shopify_attributes }}>
          <summary style="padding: 14px 18px; cursor: pointer; font-weight: 600; color: var(--km-text-primary); list-style: none; display: flex; justify-content: space-between; align-items: center; background: rgba(197,160,89,0.05);">
            {{ block.settings.question }}
            <span style="font-size: 1.2rem; color: var(--km-gold-dark);">+</span>
          </summary>
          <div style="padding: 14px 18px; color: var(--km-text-secondary); line-height: 1.7; font-size: 0.93rem; border-top: 1px solid rgba(197,160,89,0.15);">
            {{ block.settings.answer }}
          </div>
        </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif %}

    {%- assign has_text_columns = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'text_column' -%}{%- assign has_text_columns = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_text_columns %}<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin:28px 0;">{%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'accordion' -%}
          <details class="km-faq-item" style="border:1px solid rgba(197,160,89,.25);border-radius:8px;margin:12px 0;" {{ block.shopify_attributes }}><summary style="padding:14px;cursor:pointer;font-weight:600;">{{ block.settings.title }}</summary><div style="padding:0 14px 14px;">{{ block.settings.content }}</div></details>
        {%- when 'text_column' -%}
          <article style="padding:20px;border:1px solid rgba(197,160,89,.2);border-radius:10px;" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2>{{ block.settings.content }}</article>
        {%- when 'contact_card' -%}
          <address style="padding:20px;border:1px solid rgba(197,160,89,.25);border-radius:10px;font-style:normal;" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2>{% if block.settings.email != blank %}<p><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></p>{% endif %}{% if block.settings.phone != blank %}<p><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></p>{% endif %}{% if block.settings.address != blank %}<p>{{ block.settings.address | newline_to_br }}</p>{% endif %}</address>
      {%- endcase -%}
    {%- endfor -%}
    {%- if has_text_columns %}</div>{%- endif %}

    {%- if page.content != blank %}
    <div class="km-page-content km-policy-section-block" style="color: var(--km-text-secondary); line-height: 1.85; font-size: {{ section.settings.body_size }}px; margin-top: 28px;">
      {{ page.content }}
    </div>
    {%- endif %}

  </div>
</section>

{% schema %}
{
  "name": "Shipping Policy Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Max Container Width",
      "min": 680,
      "max": 1200,
      "step": 40,
      "default": 880,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Font Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "highlight_card",
      "name": "Highlight Card",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji Icon",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pan-India Delivery"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "7–10 business days via Delhivery, DTDC & India Post."
        }
      ]
    },
    {
      "type": "rate_row",
      "name": "Shipping Rate Row",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "zone",
          "label": "Zone",
          "default": "India (Domestic)"
        },
        {
          "type": "text",
          "id": "method",
          "label": "Courier Method",
          "default": "Delhivery / DTDC"
        },
        {
          "type": "text",
          "id": "timeline",
          "label": "Delivery Timeline",
          "default": "7–10 business days"
        },
        {
          "type": "text",
          "id": "rate",
          "label": "Rate / COD Info",
          "default": "COD available"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Do you ship internationally?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Yes — we ship to 42+ countries via FedEx & DHL Express. Estimated delivery: 8 business days."
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Frequently asked question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your answer here.</p>"
        }
      ]
    },
    {
      "type": "text_column",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Helpful information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add details here.</p>"
        }
      ]
    },
    {
      "type": "contact_card",
      "name": "Contact card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Contact us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "support@kraftmart.shop"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+917508427731"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Amritsar, Punjab, India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping Policy Page",
      "blocks": [
        {
          "type": "highlight_card",
          "settings": {
            "icon": "🚚",
            "title": "Pan-India Delivery",
            "description": "7–10 business days via Delhivery, DTDC & India Post."
          }
        },
        {
          "type": "highlight_card",
          "settings": {
            "icon": "✈️",
            "title": "Export Shipping",
            "description": "8 business days via FedEx & DHL Express to 42+ countries."
          }
        },
        {
          "type": "highlight_card",
          "settings": {
            "icon": "🎁",
            "title": "Secure Packaging",
            "description": "Damage-resistant velvet armor casing on every order."
          }
        },
        {
          "type": "rate_row",
          "settings": {
            "zone": "India (Domestic)",
            "method": "Delhivery / DTDC / India Post",
            "timeline": "7–10 business days",
            "rate": "COD available (15% advance)"
          }
        },
        {
          "type": "rate_row",
          "settings": {
            "zone": "International (Export)",
            "method": "FedEx / DHL Express",
            "timeline": "8 business days",
            "rate": "Prepaid only"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "Yes — we ship to 42+ countries via FedEx & DHL Express."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "COD is available within India. Pay 15% advance at order, 85% on delivery."
          }
        }
      ]
    }
  ]
}
{% endschema %}
