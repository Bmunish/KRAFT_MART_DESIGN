  <!-- Mobile Filter Drawer (Slide-out from left with backdrop blur) -->
  <div id="kmMobileFilterDrawer" class="km-drawer-overlay" role="dialog" aria-modal="true" aria-label="Filters">
    <div class="km-drawer-backdrop" id="kmDrawerBackdrop"></div>
    <div class="km-drawer-panel">
      <div class="km-drawer-header">
        <div style="display: flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
          <h3 class="km-drawer-title">Filter Catalogue</h3>
        </div>
        <button class="km-drawer-close" id="kmCloseMobileFilter" aria-label="Close Filters">&#10005;</button>
      </div>

      <div class="km-drawer-body">
        <!-- Category Group -->
        <div class="km-filter-group">
          <div class="km-filter-section-title">
            <span>Category</span>
          </div>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox km-filter-cat" value="all" checked /> All Collections</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox km-filter-cat" value="wedding" /> Wedding Swords (4)</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox km-filter-cat" value="damascus" /> Damascus Steel (3)</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox km-filter-cat" value="miniature" /> Miniatures &amp; Kirpans (2)</label>
        </div>

        <!-- Price Range Group -->
        <div class="km-filter-group">
          <div class="km-filter-section-title">
            <span>Price Range</span>
          </div>
          <div class="km-filter-chips-grid">
            <button class="km-filter-chip active" data-price="all">All</button>
            <button class="km-filter-chip" data-price="under2000">&lt; ₹2,000</button>
            <button class="km-filter-chip" data-price="2000-4000">₹2k – ₹4k</button>
            <button class="km-filter-chip" data-price="above4000">&gt; ₹4,000</button>
          </div>
        </div>

        <!-- Blade Steel Type Group -->
        <div class="km-filter-group">
          <div class="km-filter-section-title">
            <span>Blade Steel</span>
          </div>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox" checked /> 1095/15N20 Damascus</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox" checked /> High Carbon Steel</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox" /> Solid Cast Brass</label>
        </div>

        <!-- Benefits Group -->
        <div class="km-filter-group" style="border-bottom: none;">
          <div class="km-filter-section-title">
            <span>Guarantees</span>
          </div>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox" checked /> Cash on Delivery (COD)</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox" checked /> Free Custom Engraving</label>
          <label class="km-checkbox-label"><input type="checkbox" class="km-custom-checkbox" checked /> Express Worldwide Dispatch</label>
        </div>
      </div>

      <div class="km-drawer-footer">
        <button class="km-btn km-btn-primary" id="kmApplyMobileFilter" style="width: 100%;">Show Results</button>
      </div>
    </div>
  </div>

