<section class="km-section km-page-custom"
  style="
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
    background-color: {{ section.settings.bg_color }};
  ">
  <div class="km-container" style="max-width: 860px; margin: 0 auto;">

    <!-- Breadcrumb -->
    <nav style="margin-bottom: 20px; font-size: 0.8rem; color: var(--km-text-secondary);" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" style="text-decoration: underline;">Home</a>
      &nbsp;/&nbsp;
      <span style="color: var(--km-gold-dark);">{{ page.title }}</span>
    </nav>

    <!-- Page Title -->
    <h1 class="km-heading-1" style="
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      color: var(--km-text-primary);
      margin-bottom: 28px;
      line-height: 1.2;
    ">
      {{ page.title }}
    </h1>

    <!-- Divider -->
    <div style="
      width: 64px; height: 3px;
      background: linear-gradient(90deg, var(--km-gold-primary), var(--km-gold-dark));
      border-radius: 2px;
      margin-bottom: 36px;
    "></div>

    <!-- Page Content (from Shopify rich text editor) -->
    <div class="km-page-content" style="
      color: var(--km-text-secondary);
      line-height: 1.85;
      font-size: 1.02rem;
    ">
      {{ page.content }}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Custom Page",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    }
  ],
  "presets": [
    {
      "name": "Custom Page"
    }
  ]
}
{% endschema %}
