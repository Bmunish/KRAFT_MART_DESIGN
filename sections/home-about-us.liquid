<!-- Heritage Story: Multirow Editorial Section Matching Live About Page -->
<section id="about-us" class="km-section"
  style="background-color: var(--km-bg-secondary); border-top: var(--km-border-subtle); border-bottom: var(--km-border-subtle); padding: 96px 0;">
  <div class="km-container">
    <!-- Section Header -->
    <div class="km-section-header km-reveal" style="text-align: center; margin-bottom: 64px;">
      <span class="km-eyebrow" style="color: var(--km-gold-primary); letter-spacing: 0.16em;">{{ section.settings.header_eyebrow | default: "❖ OUR HERITAGE & ARTISANAL LINEAGE ❖" }}</span>
      <h2 class="km-heading-1" style="color: var(--km-text-primary); font-size: clamp(2.2rem, 3.8vw, 3.2rem); margin: 8px 0 14px 0;">
        {{ section.settings.header_title | default: "Lakshmi Engineering Works → KraftMart" }}
      </h2>
      <p class="km-body-lead" style="color: var(--km-text-secondary); max-width: 760px; margin: 0 auto;">
        {{ section.settings.header_description | default: "Situated in the land of five rivers, Punjab — our journey began in 1996 with precision nickel and chrome electroplating, evolving into KraftMart on 1st November 2019 to bring authentic Sikh articles, wedding swords, and Indo-traditional handicrafts to patrons across the globe." }}
      </p>
    </div>

    <!-- Story Row 1: Lakshmi Engineering Works (Image Left, Content Right) -->
    <div style="display: grid; grid-template-columns: 1fr 1.15fr; align-items: center; gap: 60px; margin-bottom: 80px;">
      <div style="position: relative;" class="km-reveal-left">
        <div style="border-radius: var(--km-radius-md); overflow: hidden; border: 1px solid rgba(197, 160, 89, 0.35); box-shadow: var(--km-shadow-medium); background: #14100D;">
          {% assign default_lakshmi_img = 'live_about_lakshmi.jpg' | asset_url %}
          <img src="{{ section.settings.row_1_image | default: default_lakshmi_img }}" alt="{{ section.settings.row_1_title | default: 'Lakshmi Engineering Works - Established 1996 in Punjab' | escape }}"
            loading="lazy" decoding="async" style="width: 100%; object-fit: cover; max-height: 480px; display: block; transition: transform 0.6s ease;" />
        </div>
        <div
          style="position: absolute; bottom: -20px; right: -20px; background-color: var(--km-bg-dark); color: var(--km-text-light); padding: 20px 24px; border-radius: var(--km-radius-md); border: var(--km-border-gold); max-width: 250px; text-align: center; box-shadow: var(--glow-gold);">
          <span
            style="font-family: var(--km-font-heading); font-size: 2.2rem; font-weight: 700; color: var(--km-gold-light); display: block; line-height: 1;">{{ section.settings.row_1_badge_year | default: "1996" }}</span>
          <span
            style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-text-muted-light);">{{ section.settings.row_1_badge_label | default: "Lakshmi Engineering Works · Punjab" }}</span>
        </div>
      </div>

      <div class="km-reveal-right">
        <span class="km-eyebrow" style="color: var(--km-gold-dark);">{{ section.settings.row_1_eyebrow | default: "SITUATE IN THE LAND OF FIVE RIVERS" }}</span>
        <h3 class="km-heading-1" style="font-size: clamp(1.6rem, 2.5vw, 2.1rem); margin-bottom: 18px; color: var(--km-text-primary);">
          {{ section.settings.row_1_title | default: "Our 1996 Roots: Electroplating, Polishing & Blade Craft" }}
        </h3>
        <p class="km-body-lead" style="margin-bottom: 16px; color: var(--km-text-primary); font-size: 1rem; line-height: 1.7;">
          {{ section.settings.row_1_lead | default: "Situate in the land of five rivers, We, Lakshmi Engineering Works, began our journey in 1996 as a product + service based enterprise. The core of our service is Nickel and Chrome Electroplating and Polishing, making the goods ready to go for their use." }}
        </p>
        <div style="background: rgba(197, 160, 89, 0.08); border: 1px solid rgba(197, 160, 89, 0.25); border-radius: 12px; padding: 18px 20px; margin-bottom: 20px;">
          <div style="font-family: var(--km-font-display); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-dark); margin-bottom: 10px;">
            {{ section.settings.row_1_box_title | default: "Main products started from & currently doing for job work:" }}
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 8px; font-size: 0.9rem; color: var(--km-text-primary);">
            <li style="display: flex; align-items: center; gap: 8px;"><span>❖</span> {{ section.settings.row_1_p1 | default: "Machinery and Corrugation parts." }}</li>
            <li style="display: flex; align-items: center; gap: 8px;"><span>❖</span> {{ section.settings.row_1_p2 | default: "Automated Stitching And Perforation machines." }}</li>
            <li style="display: flex; align-items: center; gap: 8px;"><span>❖</span> {{ section.settings.row_1_p3 | default: "Hand-tool drilling machines." }}</li>
            <li style="display: flex; align-items: center; gap: 8px;"><span>❖</span> {{ section.settings.row_1_p4 | default: "Accessories of various vintage vehicles (silencer, handles, rims, etc.)" }}</li>
            <li style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--km-crimson-primary);"><span>⚔️</span> {{ section.settings.row_1_p5 | default: "Kirpan / Sword blades – MAJORLY OUR JOB WORK SERVICE." }}</li>
          </ul>
        </div>

        <p style="color: var(--km-text-secondary); line-height: 1.7; font-size: 0.92rem; margin-bottom: 22px;">
          {{ section.settings.row_1_body | default: "Our Own Line of Products: In addition to this, we also deal in Sikh Items used for Prakash purposes for Shri Guru Granth Sahib (Prakash Arrowhead / Teer, Prakash Chakar, Prakash Chawar). Backed by 20+ years of electroplating mastery and deep association with Sikhism, we embarked on a product-based startup on 1st November, 2019. Serving 4,900+ clients worldwide." }}
        </p>

        <a href="{{ section.settings.row_1_btn_url | default: '/pages/about' }}" class="km-btn km-btn-outline" style="padding: 12px 24px; font-size: 0.9rem;">
          {{ section.settings.row_1_btn_text | default: "Read The Complete History →" }}
        </a>
      </div>
    </div>

    <!-- Story Row 2: KraftMart (Content Left, Image Right) -->
    <div style="display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 60px;">
      <div class="km-reveal-left">
        <span class="km-eyebrow" style="color: var(--km-gold-dark);">{{ section.settings.row_2_eyebrow | default: "PROUD SUBSIDIARY OF LAKSHMI ENGINEERING WORKS" }}</span>
        <h3 class="km-heading-1" style="font-size: clamp(1.6rem, 2.5vw, 2.1rem); margin-bottom: 18px; color: var(--km-text-primary);">
          {{ section.settings.row_2_title | default: "A Venture Called KraftMart: Your All-In-One Heritage Store" }}
        </h3>
        <p class="km-body-lead" style="margin-bottom: 16px; color: var(--km-text-primary); font-size: 1rem; line-height: 1.7;">
          {{ section.settings.row_2_lead | default: "As a proud subsidiary of Lakshmi Engineering Works, at KraftMart, we specialize in creating exquisite Indo-traditional handicrafts, Sikh Kakar articles, and bidding accessories, catering to a diverse clientele who appreciate authentic and culturally rich items." }}
        </p>

        <div style="background: rgba(197, 160, 89, 0.08); border: 1px solid rgba(197, 160, 89, 0.25); border-radius: 12px; padding: 18px 20px; margin-bottom: 20px;">
          <div style="font-family: var(--km-font-display); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-dark); margin-bottom: 10px;">
            {{ section.settings.row_2_box_title | default: "Your All-In-One Store For:" }}
          </div>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; font-size: 0.88rem; color: var(--km-text-primary);">
            <div style="display: flex; align-items: center; gap: 6px;"><span>☬</span> Customized Sikh Articles &amp; Accessories</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span>💍</span> Personalized Bidding Handicrafts</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span>✍️</span> Custom Engraving Options</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span>⚡</span> Punjabi Hand-Cuff Katas</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span>🧵</span> Elegant Gold &amp; Silver Wire Work</div>
            <div style="display: flex; align-items: center; gap: 6px;"><span>🛡️</span> Miniatures Collectibles Pieces</div>
            <div style="display: flex; align-items: center; gap: 6px; grid-column: span 2;"><span>🏡</span> Home Décor — Wall Hanging Products</div>
          </div>
        </div>

        <p style="color: var(--km-text-secondary); line-height: 1.7; font-size: 0.92rem; margin-bottom: 24px;">
          {{ section.settings.row_2_body | default: "Our commitment to customer satisfaction is unwavering; we have a dedicated team that promptly addresses and resolves customer requests, ensuring a seamless and pleasant shopping experience. To further enhance our services, we maintain a FedEx account, facilitating swift and reliable delivery within 10 days, excluding processing time." }}
        </p>

        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href="{{ section.settings.row_2_btn1_url | default: '/collections/all' }}" class="km-btn km-btn-primary">{{ section.settings.row_2_btn1_text | default: "Explore All Collections →" }}</a>
          <a href="{{ section.settings.row_2_btn2_url | default: '/pages/about' }}" class="km-btn km-btn-outline" style="padding: 14px 22px;">{{ section.settings.row_2_btn2_text | default: "View Our Full Story" }}</a>
        </div>
      </div>

      <div style="position: relative;" class="km-reveal-right">
        <div style="border-radius: var(--km-radius-md); overflow: hidden; border: 1px solid rgba(197, 160, 89, 0.35); box-shadow: var(--km-shadow-medium); background: #14100D;">
          {% assign default_kraftmart_img = 'live_about_kraftmart.jpg' | asset_url %}
          <img src="{{ section.settings.row_2_image | default: default_kraftmart_img }}" alt="{{ section.settings.row_2_title | default: 'KraftMart Exquisite Indo-Traditional Handicrafts and Wedding Swords' | escape }}"
            loading="lazy" decoding="async" style="width: 100%; object-fit: cover; max-height: 480px; display: block; transition: transform 0.6s ease;" />
        </div>
        <div
          style="position: absolute; bottom: -20px; left: -20px; background-color: var(--km-bg-dark); color: var(--km-text-light); padding: 18px 22px; border-radius: var(--km-radius-md); border: var(--km-border-gold); max-width: 240px; text-align: center; box-shadow: var(--glow-gold);">
          <span
            style="font-family: var(--km-font-heading); font-size: 1.8rem; font-weight: 700; color: var(--km-gold-light); display: block; line-height: 1;">{{ section.settings.row_2_badge_stat | default: "10 Days" }}</span>
          <span
            style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-text-muted-light);">{{ section.settings.row_2_badge_label | default: "FedEx Worldwide Delivery" }}</span>
        </div>
      </div>
    </div>

  </div>
</section>

