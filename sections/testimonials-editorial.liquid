{% comment %}
  KRAFTMART — EDITORIAL TESTIMONIALS SECTION
{% endcomment %}

<section class="km-section" style="background-color: var(--km-bg-secondary);">
  <div class="km-container">
    <div class="km-section-header">
      <span class="km-eyebrow">VERIFIED BUYER REVIEWS</span>
      <h2 class="km-heading-1">Treasured by Families Worldwide</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px;">
      <div style="background: #FFF; padding: 32px; border-radius: var(--km-radius-md); border: var(--km-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="color: var(--km-gold-primary); margin-bottom: 16px; font-size: 1.25rem;">★★★★★</div>
          <p style="font-family: var(--km-font-heading); font-size: 1.2rem; font-style: italic; line-height: 1.5; color: var(--km-text-primary); margin-bottom: 24px;">
            "An absolute treasure. The craftsmanship is unparalleled, a true family heirloom that brought incredible dignity to my wedding entry."
          </p>
        </div>
        <div>
          <strong style="display: block; font-size: 0.9375rem;">Rajesh P.</strong>
          <span style="font-size: 0.75rem; color: var(--km-text-secondary);">Verified Customer — London, UK</span>
        </div>
      </div>

      <div style="background: #FFF; padding: 32px; border-radius: var(--km-radius-md); border: var(--km-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="color: var(--km-gold-primary); margin-bottom: 16px; font-size: 1.25rem;">★★★★★</div>
          <p style="font-family: var(--km-font-heading); font-size: 1.2rem; font-style: italic; line-height: 1.5; color: var(--km-text-primary); margin-bottom: 24px;">
            "Exceeded all expectations. The detail on the velvet scabbard and custom laser engraving on the blade is breathtaking."
          </p>
        </div>
        <div>
          <strong style="display: block; font-size: 0.9375rem;">Priya S.</strong>
          <span style="font-size: 0.75rem; color: var(--km-text-secondary);">Verified Customer — Toronto, Canada</span>
        </div>
      </div>

      <div style="background: #FFF; padding: 32px; border-radius: var(--km-radius-md); border: var(--km-border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="color: var(--km-gold-primary); margin-bottom: 16px; font-size: 1.25rem;">★★★★★</div>
          <p style="font-family: var(--km-font-heading); font-size: 1.2rem; font-style: italic; line-height: 1.5; color: var(--km-text-primary); margin-bottom: 24px;">
            "More than a sword, it’s a piece of history. Delivered safely to California in perfect condition with fast tracking."
          </p>
        </div>
        <div>
          <strong style="display: block; font-size: 0.9375rem;">Vikram R.</strong>
          <span style="font-size: 0.75rem; color: var(--km-text-secondary);">Verified Customer — California, USA</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Testimonials",
  "settings": [],
  "presets": [
    {
      "name": "Customer Testimonials",
      "category": "Social Proof"
    }
  ]
}
{% endschema %}
