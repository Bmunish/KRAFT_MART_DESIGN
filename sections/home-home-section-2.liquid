<!-- Section 2: Drag-to-Scroll Featured Collections Carousel -->
<section class="km-section" style="padding: 24px 0 44px 0;">
  <div class="km-container">
    <div class="km-section-header"
      style="text-align: left; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px;">
      <div>
        <span class="km-eyebrow" style="margin-bottom: 2px; font-size: 0.72rem; letter-spacing: 0.14em;">{{ section.settings.subtitle | default: "CURATED HERITAGE SELECTIONS" }}</span>
        <h2 class="km-heading-1" style="color: var(--color-ink-navy); font-size: clamp(1.8rem, 3.2vw, 2.4rem); margin: 0; line-height: 1.15;">{{ section.settings.title | default: "Explore Collections" }}</h2>
      </div>
      <span style="font-size: 0.8rem; color: var(--color-slate-gray); font-weight: 500;">{{ section.settings.scroll_hint | default: "← Drag or swipe to scroll →" }}</span>
    </div>

    <div class="km-category-carousel-wrapper">
      <div class="km-category-carousel">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign coll = collections[block.settings.collection] %}
            {% assign card_title = block.settings.title | default: coll.title | default: "Featured Collection" %}
            {% assign card_link = block.settings.link | default: coll.url | default: "/collections/all" %}
            {% assign default_cat_img = 'hero_talwar.png' | asset_url %}
            {% assign card_img = block.settings.image | default: coll.image | default: coll.products.first.featured_image | default: default_cat_img %}
            {% assign card_tag = block.settings.tag | default: "Collection" %}
            <a href="{{ card_link }}" class="km-category-item-card" title="{{ card_title | escape }}" {{ block.shopify_attributes }}>
              <img src="{{ card_img }}" alt="{{ card_title | escape }}" decoding="async" loading="lazy" />
              <div class="km-category-card-overlay">
                <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-light);">{{ card_tag }}</span>
                <h3 style="font-family: var(--km-font-heading); font-size: 1.4rem; font-weight: 600;">{{ card_title }}</h3>
              </div>
            </a>
          {% endfor %}
        {% else %}
          <a href="/collections/wedding-swords" class="km-category-item-card" title="Explore Wedding Swords">
            <img src="{{ 'hero_talwar.png' | asset_url }}" alt="Wedding Swords &amp; Decorative" decoding="async" loading="lazy" />
            <div class="km-category-card-overlay">
              <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-light);">Bestseller</span>
              <h3 style="font-family: var(--km-font-heading); font-size: 1.4rem; font-weight: 600;">Wedding Swords</h3>
            </div>
          </a>

          <a href="/collections/all?category=damascus" class="km-category-item-card" title="Explore Premium Talwars">
            <img src="{{ 'sword2.png' | asset_url }}" alt="Handforged Damascus Talwars" decoding="async" loading="lazy" />
            <div class="km-category-card-overlay">
              <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-light);">Master Metallurgy</span>
              <h3 style="font-family: var(--km-font-heading); font-size: 1.4rem; font-weight: 600;">Premium Talwars</h3>
            </div>
          </a>

          <a href="/collections/all?price=under2000" class="km-category-item-card" title="Explore Swords Under ₹2000">
            <img src="{{ 'sword.png' | asset_url }}" alt="Swords Under ₹2000" decoding="async" loading="lazy" />
            <div class="km-category-card-overlay">
              <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-light);">Ceremonial Value</span>
              <h3 style="font-family: var(--km-font-heading); font-size: 1.4rem; font-weight: 600;">Swords Under ₹2,000</h3>
            </div>
          </a>

          <a href="/collections/all?category=wall-hangings" class="km-category-item-card" title="Explore Wall Hangings">
            <img src="{{ 'hero_talwar.png' | asset_url }}" alt="Royal Wall Hangings" decoding="async" loading="lazy" />
            <div class="km-category-card-overlay">
              <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-light);">Haveli Decor</span>
              <h3 style="font-family: var(--km-font-heading); font-size: 1.4rem; font-weight: 600;">Wall Hangings</h3>
            </div>
          </a>

          <a href="/collections/all?category=miniature" class="km-category-item-card" title="Explore Miniatures &amp; Khandas">
            <img src="{{ 'sword.png' | asset_url }}" alt="Miniatures &amp; Khandas" decoding="async" loading="lazy" />
            <div class="km-category-card-overlay">
              <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--km-gold-light);">Collectibles</span>
              <h3 style="font-family: var(--km-font-heading); font-size: 1.4rem; font-weight: 600;">Miniatures &amp; Khandas</h3>
            </div>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Eyebrow Subtitle",
      "default": "CURATED HERITAGE SELECTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore Collections"
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "Scroll Hint",
      "default": "← Drag or swipe to scroll →"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image Override"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Badge Tag",
          "default": "Bestseller"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Wedding Swords",
            "tag": "Bestseller"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Premium Talwars",
            "tag": "Master Metallurgy"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Swords Under ₹2,000",
            "tag": "Ceremonial Value"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Wall Hangings",
            "tag": "Haveli Decor"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Miniatures & Khandas",
            "tag": "Collectibles"
          }
        }
      ]
    }
  ]
}
{% endschema %}
