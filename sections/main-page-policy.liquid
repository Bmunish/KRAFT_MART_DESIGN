{%- assign pad_top = section.settings.padding_top -%}
{%- assign pad_bot = section.settings.padding_bottom -%}

<section class="km-section km-page-policy" style="padding: {{ pad_top }}px 0 {{ pad_bot }}px; background: {{ section.settings.bg_color }};">
  <div class="km-container" style="text-align: {{ section.settings.text_alignment }};">

    {%- comment %} ── Policy Nav Strip ── {%- endcomment %}
    <div class="km-policy-nav-strip" style="margin-bottom: 32px;">
      <a href="/policies/shipping-policy" class="km-policy-tab-link">🚚 Shipping</a>
      <a href="/pages/processing-time" class="km-policy-tab-link">⏱️ Processing</a>
      <a href="/policies/refund-policy" class="km-policy-tab-link">↩ Returns</a>
      <a href="/policies/privacy-policy" class="km-policy-tab-link active">🔒 Privacy</a>
      <a href="/pages/contact" class="km-policy-tab-link">✉ Contact</a>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 40px; max-width: {{ section.settings.container_width }}px; margin: 0 auto;">

      {%- comment %} ── SIDEBAR NAV + MAIN CONTENT grid on desktop ── {%- endcomment %}
      {%- assign has_anchors = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'anchor_link' -%}{%- assign has_anchors = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}

      <div style="display: grid; grid-template-columns: {% if has_anchors %}220px 1fr{% else %}1fr{% endif %}; gap: 40px; align-items: start;">

        {%- if has_anchors %}
        {%- comment %} ── Sidebar Anchor Navigation ── {%- endcomment %}
        <aside style="position: sticky; top: 100px;">
          <div style="
            background: rgba(197,160,89,0.07);
            border: 1px solid rgba(197,160,89,0.25);
            border-radius: 12px;
            padding: 20px 18px;">
            <p style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--km-gold-dark); font-weight: 700; margin-bottom: 14px;">Contents</p>
            <nav>
              {%- for block in section.blocks -%}
                {%- if block.type == 'anchor_link' -%}
                <a href="#{{ block.settings.anchor_id }}" style="
                  display: block; padding: 7px 0;
                  color: var(--km-text-secondary); text-decoration: none;
                  font-size: 0.88rem; border-bottom: 1px solid rgba(197,160,89,0.12);
                  transition: color 0.2s;"
                  onmouseover="this.style.color='var(--km-gold-dark)'"
                  onmouseout="this.style.color='var(--km-text-secondary)'">
                  {{ block.settings.anchor_label }}
                </a>
                {%- endif -%}
              {%- endfor -%}
            </nav>
          </div>
        </aside>
        {%- endif %}

        {%- comment %} ── Main Content Column ── {%- endcomment %}
        <div>
          {%- comment %} ── Page Title ── {%- endcomment %}
          <h1 class="km-heading-1" style="font-size: {{ section.settings.title_size }}px; margin-bottom: 8px; color: var(--km-text-primary);">
            {{ page.title | default: "Privacy Policy" }}
          </h1>
          <div style="width: 56px; height: 3px; background: linear-gradient(90deg, var(--km-gold-primary), var(--km-gold-dark)); border-radius: 2px; margin-bottom: 14px;"></div>

          {%- comment %} ── Last Updated Badge ── {%- endcomment %}
          {%- if section.settings.last_updated != blank %}
          <div style="
            display: inline-flex; align-items: center; gap: 6px;
            background: rgba(197,160,89,0.1); border: 1px solid rgba(197,160,89,0.3);
            border-radius: 20px; padding: 4px 14px; margin-bottom: 28px;
            font-size: 0.8rem; color: var(--km-text-secondary); font-weight: 600;">
            📅 Last Updated: {{ section.settings.last_updated }}
          </div>
          {%- endif %}

          {%- comment %} ── Dynamic Blocks ── {%- endcomment %}
          {%- for block in section.blocks -%}

            {%- if block.type == 'text_section' -%}
            <div class="km-policy-section-block" id="{{ block.settings.anchor_id }}" style="margin-bottom: 28px; scroll-margin-top: 100px;" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank %}
              <h2 style="font-size: {{ section.settings.heading_size }}px; color: var(--km-text-primary); margin-bottom: 14px;">
                {%- if block.settings.heading_icon != blank %}{{ block.settings.heading_icon }} {%- endif %}{{ block.settings.heading }}
              </h2>
              {%- endif %}
              <div style="color: var(--km-text-secondary); line-height: 1.85; font-size: {{ section.settings.body_size }}px;">
                {{ block.settings.content }}
              </div>
            </div>

            {%- elsif block.type == 'anchor_link' -%}
            {%- comment %} anchor_link blocks are rendered in sidebar only, skip here {%- endcomment %}

            {%- endif -%}
          {%- endfor -%}

          {%- comment %} ── Shopify Page Rich Text Content ── {%- endcomment %}
          {%- assign has_text_columns = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'text_column' -%}{%- assign has_text_columns = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_text_columns %}<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin:28px 0;">{%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'accordion' -%}
          <details class="km-faq-item" style="border:1px solid rgba(197,160,89,.25);border-radius:8px;margin:12px 0;" {{ block.shopify_attributes }}><summary style="padding:14px;cursor:pointer;font-weight:600;">{{ block.settings.title }}</summary><div style="padding:0 14px 14px;">{{ block.settings.content }}</div></details>
        {%- when 'text_column' -%}
          <article style="padding:20px;border:1px solid rgba(197,160,89,.2);border-radius:10px;" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2>{{ block.settings.content }}</article>
        {%- when 'contact_card' -%}
          <address style="padding:20px;border:1px solid rgba(197,160,89,.25);border-radius:10px;font-style:normal;" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2>{% if block.settings.email != blank %}<p><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></p>{% endif %}{% if block.settings.phone != blank %}<p><a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a></p>{% endif %}{% if block.settings.address != blank %}<p>{{ block.settings.address | newline_to_br }}</p>{% endif %}</address>
      {%- endcase -%}
    {%- endfor -%}
    {%- if has_text_columns %}</div>{%- endif %}

    {%- if page.content != blank %}
          <div class="km-page-content km-policy-section-block" style="color: var(--km-text-secondary); line-height: 1.85; font-size: {{ section.settings.body_size }}px; margin-top: 8px;">
            {{ page.content }}
          </div>
          {%- endif %}

        </div>{%- comment %} end main col {%- endcomment %}
      </div>{%- comment %} end grid {%- endcomment %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policy / Legal Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Max Container Width",
      "min": 680,
      "max": 1200,
      "step": 40,
      "default": 920,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 20,
      "max": 48,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Section Heading Size",
      "min": 16,
      "max": 32,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Font Size",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last Updated Date",
      "default": "November 1, 2024",
      "info": "Displays a badge below the title. Leave blank to hide."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "anchor_link",
      "name": "Sidebar Anchor Link",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "anchor_label",
          "label": "Link Label",
          "default": "Section Title"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID (must match text_section anchor ID)",
          "default": "section-1"
        }
      ]
    },
    {
      "type": "text_section",
      "name": "Text Section",
      "limit": 16,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Section Heading",
          "default": "1. Information We Collect"
        },
        {
          "type": "text",
          "id": "heading_icon",
          "label": "Heading Emoji Icon",
          "default": "🔍"
        },
        {
          "type": "text",
          "id": "anchor_id",
          "label": "Anchor ID (for sidebar link)",
          "default": "section-1",
          "info": "Use lowercase letters and hyphens only."
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Section Content",
          "default": "<p>We collect information you provide directly to us when you make a purchase, contact customer support, or interact with our store.</p>"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Frequently asked question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your answer here.</p>"
        }
      ]
    },
    {
      "type": "text_column",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Helpful information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add details here.</p>"
        }
      ]
    },
    {
      "type": "contact_card",
      "name": "Contact card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Contact us"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "sales@kraftmart.shop"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+917508427731"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Amritsar, Punjab, India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy / Legal Page",
      "blocks": [
        {
          "type": "anchor_link",
          "settings": {
            "anchor_label": "Information We Collect",
            "anchor_id": "info-collect"
          }
        },
        {
          "type": "anchor_link",
          "settings": {
            "anchor_label": "How We Use Your Data",
            "anchor_id": "data-use"
          }
        },
        {
          "type": "anchor_link",
          "settings": {
            "anchor_label": "Data Security",
            "anchor_id": "security"
          }
        },
        {
          "type": "text_section",
          "settings": {
            "heading": "1. Information We Collect",
            "heading_icon": "🔍",
            "anchor_id": "info-collect",
            "content": "<p>We collect personal information you provide when placing an order: name, shipping address, phone number, and email address.</p>"
          }
        },
        {
          "type": "text_section",
          "settings": {
            "heading": "2. How We Use Your Data",
            "heading_icon": "⚙️",
            "anchor_id": "data-use",
            "content": "<p>Your data is used to process and fulfill orders, send order updates, and respond to support requests.</p>"
          }
        },
        {
          "type": "text_section",
          "settings": {
            "heading": "3. Data Security",
            "heading_icon": "🛡️",
            "anchor_id": "security",
            "content": "<p>We use industry-standard encryption and Shopify's secure checkout to protect your information.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
