<!-- Ultra-Compact Minimalist Luxury Page Header -->
<section class="km-page-hero km-glass-hero km-hero-minimal">
  <div class="km-bg-gradient-container" aria-hidden="true">
    <div class="km-gradients-group">
      <div class="km-gradient-blob km-first"></div>
      <div class="km-gradient-blob km-second"></div>
      <div class="km-gradient-blob km-third"></div>
      <div class="km-gradient-blob km-fourth"></div>
      <div class="km-gradient-blob km-fifth"></div>
      <div class="km-gradient-blob km-interactive"></div>
    </div>
  </div>
  <div class="km-container km-page-hero-inner" style="display: flex; align-items: center; justify-content: space-between; gap: 24px; position: relative; z-index: 2; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 280px; text-align: left;">
      <div class="km-page-hero-breadcrumb" style="margin-bottom: 4px; font-size: 0.74rem;">
        <a href="{{ routes.root_url }}">Home</a>
        <span>›</span>
        <span style="color: var(--km-gold-light);">Contact Us</span>
      </div>
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 4px;">
        <h1 class="km-heading-hero" style="font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin: 0; line-height: 1.2;">Get in Touch with KraftMart</h1>
        <span class="km-glass-badge">📍 Amritsar Workshop Support</span>
      </div>
      <p class="km-page-hero-lead" style="margin: 0; max-width: 580px; font-size: 0.82rem; line-height: 1.45; color: rgba(250,247,242,0.7);">Direct consultation for laser blade engraving, domestic COD advance &amp; worldwide FedEx/DHL express dispatches.</p>
    </div>
    <div class="km-mini-showcase">
      <a href="https://wa.me/917508427731" target="_blank" rel="noopener noreferrer" class="km-mini-pill" style="text-decoration: none;">
        <div class="km-mini-img-box" style="background: rgba(37,211,102,0.15); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">💬</div>
        <div class="km-mini-info">
          <div class="km-mini-tag" style="color: #25D366;">Instant Concierge</div>
          <div class="km-mini-title">WhatsApp Support</div>
          <div class="km-mini-price" style="font-size: 0.78rem; color: #FAF7F2;">+91-75084-27731 <span class="km-mini-save" style="background: rgba(37,211,102,0.2); color: #25D366;">Online</span></div>
        </div>
        <span class="km-mini-btn">→</span>
      </a>
    </div>
  </div>
</section>

<!-- Why Contact Us — Mini features row -->
