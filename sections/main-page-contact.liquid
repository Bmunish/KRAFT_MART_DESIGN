  <div class="km-container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0;">
      <div style="display: flex; align-items: center; gap: 14px; padding: 16px 24px; border-right: 1px solid rgba(197,160,89,0.15);" class="km-reveal" data-delay="1">
        <span style="font-size: 1.5rem;">✍</span>
        <div>
          <div style="font-size: 0.83rem; font-weight: 700; color: var(--km-text-primary);">Custom Engraving</div>
          <div style="font-size: 0.75rem; color: var(--km-text-secondary);">Names, dates, shlokas</div>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 14px; padding: 16px 24px; border-right: 1px solid rgba(197,160,89,0.15);" class="km-reveal" data-delay="2">
        <span style="font-size: 1.5rem;">🪙</span>
        <div>
          <div style="font-size: 0.83rem; font-weight: 700; color: var(--km-text-primary);">COD Support</div>
          <div style="font-size: 0.75rem; color: var(--km-text-secondary);">15% advance · 85% on delivery</div>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 14px; padding: 16px 24px; border-right: 1px solid rgba(197,160,89,0.15);" class="km-reveal" data-delay="3">
        <span style="font-size: 1.5rem;">✈</span>
        <div>
          <div style="font-size: 0.83rem; font-weight: 700; color: var(--km-text-primary);">Express Shipping</div>
          <div style="font-size: 0.75rem; color: var(--km-text-secondary);">FedEx &amp; DHL · 42+ countries</div>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 14px; padding: 16px 24px;" class="km-reveal" data-delay="4">
        <span style="font-size: 1.5rem;">📦</span>
        <div>
          <div style="font-size: 0.83rem; font-weight: 700; color: var(--km-text-primary);">5–7 Day Dispatch</div>
          <div style="font-size: 0.75rem; color: var(--km-text-secondary);">Handcrafted to order</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Main Contact Form + Info -->
<section class="km-section" style="padding: 80px 0 100px 0;">
  <div class="km-container">
    <div style="display: grid; grid-template-columns: 1.15fr 1fr; gap: 60px; align-items: flex-start;">

      <!-- Contact Form -->
      <div class="km-reveal-left">
        <div style="background: #FFFFFF; border: 1px solid rgba(197,160,89,0.2); border-radius: 20px; padding: 44px 40px; box-shadow: 0 12px 40px rgba(20,18,16,0.08);">
          <div style="margin-bottom: 32px;">
            <span class="km-eyebrow">Send a Message</span>
            <h2 style="font-family: var(--km-font-heading); font-size: 1.9rem; color: var(--km-text-primary); margin-top: 6px;">We'll Respond in Hours</h2>
          </div>

          {% form 'contact' %}
            {% if form.posted_successfully? %}
              <div style="background: rgba(37,211,102,0.1); border: 1px solid rgba(37,211,102,0.3); border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; color: #1a7c3e; font-weight: 500;">
                ✅ Thank you! Our Amritsar team will respond within 2–4 hours.
              </div>
            {% endif %}
            {% if form.errors %}
              <div style="background: rgba(220,38,38,0.08); border: 1px solid rgba(220,38,38,0.2); border-radius: 12px; padding: 16px 20px; margin-bottom: 24px; color: #dc2626;">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
              <div>
                <label class="km-form-label">Your Name *</label>
                <input type="text" name="contact[name]" required placeholder="Gurpreet Singh" class="km-form-input" value="{{ form.name }}" />
              </div>
              <div>
                <label class="km-form-label">Phone / WhatsApp *</label>
                <input type="tel" name="contact[phone]" placeholder="+91 98765 43210" class="km-form-input" />
              </div>
            </div>

            <div style="margin-bottom: 16px;">
              <label class="km-form-label">Email Address *</label>
              <input type="email" name="contact[email]" required placeholder="gurpreet@example.com" class="km-form-input" value="{{ form.email }}" />
            </div>

            <div style="margin-bottom: 16px;">
              <label class="km-form-label">Inquiry Type</label>
              <select name="contact[body_inquiry_type]" class="km-form-input km-form-select" style="cursor: pointer;">
                <option>Custom Engraving Request</option>
                <option>COD Order Support</option>
                <option>International Shipping Inquiry</option>
                <option>Product Question</option>
                <option>Other</option>
              </select>
            </div>

            <div style="margin-bottom: 28px;">
              <label class="km-form-label">Order Details &amp; Custom Engraving</label>
              <textarea name="contact[body]" rows="4" placeholder="Tell us your wedding date, sword style preference, or custom engraving text (names, dates, shlokas)..." class="km-form-input km-form-textarea">{{ form.body }}</textarea>
            </div>

            <button type="submit" class="km-btn km-btn-primary" style="width: 100%; padding: 16px; font-size: 0.82rem;">
              SEND MESSAGE &rarr;
            </button>

            <p style="font-size: 0.75rem; color: var(--km-text-secondary); text-align: center; margin-top: 14px; line-height: 1.6;">
              🔒 Your information is secure. We respond within 2–4 hours on weekdays.
            </p>
          {% endform %}
        </div>
      </div>

      <!-- Contact Information Cards -->
      <div class="km-reveal-right" style="display: flex; flex-direction: column; gap: 20px;">

        <!-- Workshop Card -->
        <div class="km-contact-card">
          <div class="km-contact-icon-wrap">📍</div>
          <span class="km-eyebrow" style="font-size: 0.68rem;">Our Forging Workshop</span>
          <h3 style="font-family: var(--km-font-heading); font-size: 1.3rem; color: var(--km-text-primary); margin: 6px 0 10px;">KraftMart Workshop &amp; Offices</h3>
          <p style="color: var(--km-text-secondary); font-size: 0.875rem; line-height: 1.65;">
            <strong style="color: var(--km-text-primary);">Lakshmi Engineering Works / KraftMart</strong><br>
            Industrial Area, GT Road, Amritsar, Punjab &ndash; 143001, India
          </p>
          <div style="margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(197,160,89,0.15); display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--km-text-secondary);">
            <span>🕘</span> Workshop Hours: Mon–Sat, 9 AM – 7 PM IST
          </div>
        </div>

        <!-- WhatsApp Card -->
        <div class="km-contact-card">
          <div class="km-contact-icon-wrap">💬</div>
          <span class="km-eyebrow" style="font-size: 0.68rem;">Instant WhatsApp COD Support</span>
          <h3 style="font-family: var(--km-font-heading); font-size: 1.3rem; color: var(--km-text-primary); margin: 6px 0 10px;">WhatsApp Concierge</h3>
          <p style="color: var(--km-text-secondary); font-size: 0.875rem; line-height: 1.65; margin-bottom: 20px;">
            Chat directly with our Amritsar craftsmen for live engraving photos, order tracking, and COD advance confirmations.
          </p>
          <a href="https://wa.me/917508427731" target="_blank" rel="noopener noreferrer" class="km-whatsapp-btn">
            <svg width="20" height="20" viewBox="0 0 30 30" fill="none"><circle cx="15" cy="15" r="15" fill="#25D366"/><path d="M20.5 18.3c-.3-.1-1.8-.9-2.1-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.1.2-.3.2-.5 0-.2-.7-1.7-.9-2.3-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.2.2 2 3 4.8 4.2.7.3 1.2.4 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4z" fill="#fff"/></svg>
            Chat on WhatsApp
          </a>
        </div>

        <!-- Global Shipping Card -->
        <div class="km-contact-card">
          <div class="km-contact-icon-wrap">✈</div>
          <span class="km-eyebrow" style="font-size: 0.68rem;">Global Express Shipping</span>
          <h3 style="font-family: var(--km-font-heading); font-size: 1.3rem; color: var(--km-text-primary); margin: 6px 0 10px;">FedEx &amp; DHL Express</h3>
          <p style="color: var(--km-text-secondary); font-size: 0.875rem; line-height: 1.65;">
            International priority dispatch to USA, Canada, UK, Australia, UAE, and Europe with full tracking and insurance.
          </p>
          <div style="margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap;">
            <span style="background: rgba(197,160,89,0.1); border: 1px solid rgba(197,160,89,0.25); border-radius: 6px; padding: 5px 12px; font-size: 0.75rem; font-weight: 600; color: var(--km-gold-dark);">FedEx: 3–7 days</span>
            <span style="background: rgba(197,160,89,0.1); border: 1px solid rgba(197,160,89,0.25); border-radius: 6px; padding: 5px 12px; font-size: 0.75rem; font-weight: 600; color: var(--km-gold-dark);">DHL: 2–5 days</span>
            <span style="background: rgba(107,29,47,0.08); border: 1px solid rgba(107,29,47,0.15); border-radius: 6px; padding: 5px 12px; font-size: 0.75rem; font-weight: 600; color: #6b1d2f;">COD: India Only</span>
          </div>
        <!-- Google Business Verified Profile Card -->
        <div class="km-contact-card" style="border: 1px solid rgba(66, 133, 244, 0.4); background: linear-gradient(135deg, #ffffff 0%, rgba(240, 246, 255, 0.95) 100%);">
          <div class="km-contact-icon-wrap" style="background: rgba(66, 133, 244, 0.1);">
            <svg width="22" height="22" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg>
          </div>
          <span class="km-eyebrow" style="font-size: 0.68rem; color: #1a73e8;">Verified Business Listing</span>
          <h3 style="font-family: var(--km-font-heading); font-size: 1.3rem; color: var(--km-text-primary); margin: 6px 0 10px;">Google Business Profile (4.9 ★)</h3>
          <p style="color: var(--km-text-secondary); font-size: 0.875rem; line-height: 1.65; margin-bottom: 18px;">
            Read authentic reviews from wedding families &amp; sword collectors worldwide, or find our verified Amritsar workshop location on Google.
          </p>
          <a href="https://www.google.com/search?sca_esv=9690ff17f276db6e&amp;rlz=1C1FHFK_enIN1105IN1105&amp;sxsrf=APpeQnuC7VLyucK3RXEanRReOrH--HBCyw:1790882647447&amp;kgmid=/g/11q2rz95sv&amp;q=Lakshmi+Engineering+Works+A.K.A+Kraftmart.shop&amp;shem=dlvs1,epsd1,esd2e,ltae,rimspwouoe&amp;shndl=30&amp;source=sh/x/loc/uni/m1/1&amp;kgs=ac419447525adea1&amp;utm_source=dlvs1,epsd1,esd2e,ltae,rimspwouoe,sh/x/loc/uni/m1/1#lrd=0x39197d192e9f82b5:0x73a13ed215287278,1,,,," target="_blank" rel="noopener noreferrer" class="km-btn km-btn-outline" style="display: inline-flex; align-items: center; gap: 8px; border-color: #4285F4; color: #1a73e8; background: #fff; font-weight: 700; font-size: 0.84rem;">
            Visit Our Google Business Profile &rarr;
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- FAQ Teaser -->
<section class="km-section" style="padding: 72px 0; background: var(--km-bg-secondary, #F3EDE4); border-top: 1px solid rgba(197,160,89,0.2);">
  <div class="km-container">
    <div class="km-reveal" style="text-align: center; margin-bottom: 48px;">
      <span class="km-eyebrow">Before You Write</span>
      <h2 class="km-heading-2">Common Questions</h2>
    </div>
    <div style="max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px;">

      <div class="km-reveal" data-delay="1" style="background: #FFFFFF; border: 1px solid rgba(197,160,89,0.2); border-radius: 12px; padding: 20px 24px; display: flex; align-items: flex-start; gap: 16px;">
        <span style="font-size: 1.2rem; flex-shrink: 0;">🪙</span>
        <div>
          <div style="font-family: var(--km-font-heading); font-size: 1rem; font-weight: 600; color: var(--km-text-primary); margin-bottom: 4px;">How does Cash on Delivery work?</div>
          <p style="font-size: 0.85rem; color: var(--km-text-secondary); line-height: 1.6;">Pay 15% advance to confirm your custom order, then 85% when the sword arrives at your doorstep. Full advance orders get an extra 5% discount.</p>
        </div>
      </div>

      <div class="km-reveal" data-delay="2" style="background: #FFFFFF; border: 1px solid rgba(197,160,89,0.2); border-radius: 12px; padding: 20px 24px; display: flex; align-items: flex-start; gap: 16px;">
        <span style="font-size: 1.2rem; flex-shrink: 0;">✍</span>
        <div>
          <div style="font-family: var(--km-font-heading); font-size: 1rem; font-weight: 600; color: var(--km-text-primary); margin-bottom: 4px;">How do I request custom laser engraving?</div>
          <p style="font-size: 0.85rem; color: var(--km-text-secondary); line-height: 1.6;">Simply mention the text you want (names, dates, shlokas) in your order notes or WhatsApp us. Engraving is FREE on all orders — our craftsmen apply it before final polishing.</p>
        </div>
      </div>

      <div class="km-reveal" data-delay="3" style="background: #FFFFFF; border: 1px solid rgba(197,160,89,0.2); border-radius: 12px; padding: 20px 24px; display: flex; align-items: flex-start; gap: 16px;">
        <span style="font-size: 1.2rem; flex-shrink: 0;">✈</span>
        <div>
          <div style="font-family: var(--km-font-heading); font-size: 1rem; font-weight: 600; color: var(--km-text-primary); margin-bottom: 4px;">Do you ship internationally?</div>
          <p style="font-size: 0.85rem; color: var(--km-text-secondary); line-height: 1.6;">Yes! We dispatch worldwide to USA, Canada, UK, Europe, Australia, UAE and beyond via FedEx and DHL Express. Full tracking details emailed upon dispatch.</p>
        </div>
      </div>

    </div>
  </div>
</section>

