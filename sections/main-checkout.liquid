<section class="km-section km-checkout-page" style="padding: 48px 0 100px 0; background: var(--km-bg-primary, #FAF7F2); min-height: 80vh;">
  <div class="km-container" style="max-width: 1140px;">
    
    <!-- Breadcrumb & Header -->
    <div style="margin-bottom: 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="font-size: 0.8rem; color: var(--km-text-secondary); margin-bottom: 6px;">
          <a href="{{ routes.root_url }}" style="text-decoration: underline;">Home</a> &nbsp;/&nbsp;
          <a href="{{ routes.cart_url }}" style="text-decoration: underline;">Cart</a> &nbsp;/&nbsp;
          <span style="color: var(--km-gold-dark, #C5A059); font-weight: 600;">Secure Checkout</span>
        </div>
        <h1 class="km-heading-2" style="margin: 0; font-size: clamp(1.8rem, 3vw, 2.4rem);">Secure Royal Checkout</h1>
      </div>
      <div style="display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #166534; background: #DCFCE7; padding: 6px 14px; border-radius: 20px; font-weight: 600; border: 1px solid #86EFAC;">
        <span>🔒 256-Bit SSL Encrypted &amp; Insured</span>
      </div>
    </div>

    <!-- Empty Cart Notice (hidden when items exist) -->
    <div id="kmCheckoutEmpty" style="display: none; text-align: center; padding: 80px 24px; background: #FFF; border-radius: 16px; border: 1px solid var(--km-border-subtle, rgba(197,160,89,0.3)); box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
      <div style="font-size: 3rem; margin-bottom: 16px;">⚔️</div>
      <h2 class="km-heading-2" style="margin-bottom: 12px;">Your Cart is Empty</h2>
      <p style="color: var(--km-text-secondary); max-width: 440px; margin: 0 auto 28px;">Discover our handcrafted Rajput wedding swords, ceremonial blades and artisan daggers before checking out.</p>
      <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="km-btn km-btn-primary" style="padding: 14px 32px;">Explore Heritage Catalogue &rarr;</a>
    </div>

    <!-- Main Checkout Grid -->
    <div id="kmCheckoutGrid" style="display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 40px; align-items: start;">
      
      <!-- Left Column: Checkout Form -->
      <div class="km-checkout-form-col">
        
        <!-- Confirmation Success Card (hidden by default) -->
        <div id="kmOrderSuccessCard" style="display: none; background: #FFF; border: 2px solid var(--km-gold-primary, #C5A059); border-radius: 16px; padding: 36px; box-shadow: 0 16px 40px rgba(197,160,89,0.15); text-align: center;">
          <div style="width: 64px; height: 64px; background: rgba(34,197,94,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; color: #16a34a; font-size: 2rem;">✓</div>
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--km-gold-dark, #C5A059); font-weight: 700;">Amritsar Forge Confirmation</span>
          <h2 class="km-heading-2" style="margin: 8px 0 16px;">Order Placed Successfully!</h2>
          <p style="color: var(--km-text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 480px; margin: 0 auto 24px;">
            Thank you for honouring our craft. Your ceremonial talwar order has been registered. Our master artisan will begin blade inspection, scabbard fitting, and custom laser engraving.
          </p>
          <div style="background: var(--km-bg-secondary, #F4EFE6); border-radius: 12px; padding: 20px; text-align: left; margin-bottom: 28px; font-size: 0.88rem; line-height: 1.8;">
            <div><strong>Order Reference:</strong> <span id="kmConfOrderNo" style="color: var(--km-gold-dark); font-weight: 700;">#KM-2026-8842</span></div>
            <div><strong>Recipient:</strong> <span id="kmConfName">Patron</span></div>
            <div><strong>Contact:</strong> <span id="kmConfContact"></span></div>
            <div><strong>Delivery Address:</strong> <span id="kmConfAddress"></span></div>
            <div><strong>Payment Mode:</strong> <span id="kmConfPayment">Cash on Delivery (COD)</span></div>
            <div><strong>Estimated Delivery:</strong> <span>7–10 Business Days (Discreet Insured Courier)</span></div>
          </div>
          <a href="{{ routes.root_url }}" class="km-btn km-btn-primary" style="padding: 14px 36px;">Return to Home &rarr;</a>
        </div>

        <form id="kmCheckoutForm" novalidate style="display: flex; flex-direction: column; gap: 28px;">
          
          <!-- Section 1: Contact Details -->
          <div class="km-checkout-box" style="background: #FFF; border-radius: 14px; padding: 28px; border: 1px solid var(--km-border-subtle, rgba(197,160,89,0.3)); box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h2 style="font-family: var(--km-font-heading); font-size: 1.25rem; margin: 0; display: flex; align-items: center; gap: 10px;">
                <span style="display: inline-flex; width: 26px; height: 26px; border-radius: 50%; background: var(--km-gold-primary, #C5A059); color: #FFF; font-size: 0.8rem; align-items: center; justify-content: center; font-weight: 700;">1</span>
                Contact Information
              </h2>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div style="grid-column: 1 / -1;">
                <label for="kmEmail" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">Email Address *</label>
                <input type="email" id="kmEmail" name="email" required placeholder="groom@example.com" autocomplete="email"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div style="grid-column: 1 / -1;">
                <label for="kmPhone" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">Mobile Phone (for Courier &amp; WhatsApp updates) *</label>
                <input type="tel" id="kmPhone" name="phone" required placeholder="+91 98765 43210" autocomplete="tel"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
            </div>
          </div>

          <!-- Section 2: Delivery Address -->
          <div class="km-checkout-box" style="background: #FFF; border-radius: 14px; padding: 28px; border: 1px solid var(--km-border-subtle, rgba(197,160,89,0.3)); box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h2 style="font-family: var(--km-font-heading); font-size: 1.25rem; margin: 0; display: flex; align-items: center; gap: 10px;">
                <span style="display: inline-flex; width: 26px; height: 26px; border-radius: 50%; background: var(--km-gold-primary, #C5A059); color: #FFF; font-size: 0.8rem; align-items: center; justify-content: center; font-weight: 700;">2</span>
                Shipping Address
              </h2>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div>
                <label for="kmFirstName" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">First Name *</label>
                <input type="text" id="kmFirstName" name="firstName" required placeholder="Groom / Patron" autocomplete="given-name"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div>
                <label for="kmLastName" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">Last Name *</label>
                <input type="text" id="kmLastName" name="lastName" required placeholder="Singh / Rathore" autocomplete="family-name"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div style="grid-column: 1 / -1;">
                <label for="kmAddress1" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">Address (House No, Street, Colony) *</label>
                <input type="text" id="kmAddress1" name="address1" required placeholder="124 Heritage Royal Enclave, Near Golden Temple Road" autocomplete="address-line1"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div style="grid-column: 1 / -1;">
                <label for="kmAddress2" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-secondary);">Apartment, Suite, Landmark (Optional)</label>
                <input type="text" id="kmAddress2" name="address2" placeholder="Suite 402, Landmark" autocomplete="address-line2"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div>
                <label for="kmCity" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">City *</label>
                <input type="text" id="kmCity" name="city" required placeholder="Amritsar / New Delhi" autocomplete="address-level2"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div>
                <label for="kmState" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">State *</label>
                <input type="text" id="kmState" name="state" required placeholder="Punjab / Rajasthan / Delhi" autocomplete="address-level1"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div>
                <label for="kmPincode" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">PIN Code *</label>
                <input type="text" id="kmPincode" name="pincode" required placeholder="143001" autocomplete="postal-code"
                  style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box;" />
              </div>
              <div>
                <label for="kmCountry" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px; color: var(--km-text-primary);">Country</label>
                <select id="kmCountry" name="country" style="width: 100%; padding: 12px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.95rem; box-sizing: border-box; background: #FFF;">
                  <option value="India" selected>India (Pan-India Express)</option>
                  <option value="United Kingdom">United Kingdom (DHL Express)</option>
                  <option value="United States">United States (FedEx Express)</option>
                  <option value="Canada">Canada (FedEx Express)</option>
                  <option value="Australia">Australia (DHL Express)</option>
                  <option value="UAE">United Arab Emirates (Express)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Section 3: Payment Options -->
          <div class="km-checkout-box" style="background: #FFF; border-radius: 14px; padding: 28px; border: 1px solid var(--km-border-subtle, rgba(197,160,89,0.3)); box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
              <h2 style="font-family: var(--km-font-heading); font-size: 1.25rem; margin: 0; display: flex; align-items: center; gap: 10px;">
                <span style="display: inline-flex; width: 26px; height: 26px; border-radius: 50%; background: var(--km-gold-primary, #C5A059); color: #FFF; font-size: 0.8rem; align-items: center; justify-content: center; font-weight: 700;">3</span>
                Payment Method
              </h2>
              <span style="font-size: 0.78rem; color: #166534; font-weight: 600;">✓ Safe &amp; Direct</span>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <!-- Option A: Cash on Delivery -->
              <label style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 2px solid var(--km-gold-primary, #C5A059); border-radius: 10px; cursor: pointer; background: rgba(197,160,89,0.05);">
                <input type="radio" name="payment_method" value="COD" checked style="accent-color: var(--km-gold-dark, #C5A059); width: 18px; height: 18px;" />
                <div style="flex-grow: 1;">
                  <div style="font-weight: 700; font-size: 0.95rem; color: var(--km-text-primary);">Cash on Delivery (COD)</div>
                  <div style="font-size: 0.8rem; color: var(--km-text-secondary);">Pay in cash or UPI directly to the courier upon doorstep delivery.</div>
                </div>
                <span style="background: #DCFCE7; color: #166534; font-size: 0.72rem; font-weight: 700; padding: 4px 8px; border-radius: 12px;">★ MOST POPULAR</span>
              </label>

              <!-- Option B: UPI (Instant) -->
              <label style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 1px solid #D1D5DB; border-radius: 10px; cursor: pointer;">
                <input type="radio" name="payment_method" value="UPI" style="accent-color: var(--km-gold-dark, #C5A059); width: 18px; height: 18px;" />
                <div style="flex-grow: 1;">
                  <div style="font-weight: 600; font-size: 0.95rem; color: var(--km-text-primary);">UPI (Google Pay / PhonePe / Paytm / BHIM)</div>
                  <div style="font-size: 0.8rem; color: var(--km-text-secondary);">Instant QR scan or VPA link at dispatch confirmation.</div>
                </div>
                <span style="font-size: 1.1rem;">⚡</span>
              </label>

              <!-- Option C: Online Cards -->
              <label style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 1px solid #D1D5DB; border-radius: 10px; cursor: pointer;">
                <input type="radio" name="payment_method" value="CARD" style="accent-color: var(--km-gold-dark, #C5A059); width: 18px; height: 18px;" />
                <div style="flex-grow: 1;">
                  <div style="font-weight: 600; font-size: 0.95rem; color: var(--km-text-primary);">Credit / Debit Card / Net Banking</div>
                  <div style="font-size: 0.8rem; color: var(--km-text-secondary);">Visa, Mastercard, RuPay, Amex via secure payment gateway.</div>
                </div>
                <span style="font-size: 1.1rem;">💳</span>
              </label>
            </div>
          </div>

          <!-- Free Engraving Instructions Reminder -->
          <div style="background: #FFF; border-radius: 14px; padding: 24px; border: 1px solid var(--km-border-subtle, rgba(197,160,89,0.3));">
            <label for="kmOrderNotes" style="display: block; font-size: 0.84rem; font-weight: 700; margin-bottom: 6px; color: var(--km-text-primary);">
              ✍️ Complimentary Laser Engraving Note (Optional)
            </label>
            <p style="font-size: 0.78rem; color: var(--km-text-secondary); margin-bottom: 10px;">Enter names, marriage date, or sacred mantra for blade spine engraving (Gurmukhi, Devanagari, English):</p>
            <textarea id="kmOrderNotes" rows="2" placeholder="e.g., Gurpreet ❤️ Simran • 24.10.2026"
              style="width: 100%; padding: 12px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;"></textarea>
          </div>

          <!-- Submit Button -->
          <button type="submit" id="kmPlaceOrderBtn" class="km-btn km-btn-primary" style="padding: 18px 36px; font-size: 1.1rem; width: 100%; border-radius: 10px; font-weight: 700; letter-spacing: 0.04em;">
            🔒 Complete Royal Order &rarr;
          </button>
        </form>

      </div>

      <!-- Right Column: Order Summary & Guarantee -->
      <div class="km-checkout-summary-col">
        <div style="background: #FFF; border-radius: 16px; padding: 28px; border: 1px solid var(--km-border-subtle, rgba(197,160,89,0.3)); box-shadow: 0 10px 30px rgba(0,0,0,0.05); position: sticky; top: 100px;">
          <h3 style="font-family: var(--km-font-heading); font-size: 1.25rem; margin: 0 0 20px; padding-bottom: 16px; border-bottom: 1px solid var(--km-border-subtle, #E5E7EB);">
            Order Summary (<span id="kmSummaryCount">0</span> items)
          </h3>

          <!-- Items List Container -->
          <div id="kmSummaryItems" style="display: flex; flex-direction: column; gap: 16px; max-height: 340px; overflow-y: auto; padding-right: 6px; margin-bottom: 24px;">
            <!-- Dynamically populated from JS -->
          </div>

          <!-- Discount Coupon Code -->
          <div style="display: flex; gap: 8px; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--km-border-subtle, #E5E7EB);">
            <input type="text" id="kmDiscountInput" placeholder="Discount Code (e.g. ROYAL10)" style="flex: 1; padding: 10px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 0.85rem; text-transform: uppercase;" />
            <button type="button" id="kmApplyDiscountBtn" class="km-btn km-btn-outline" style="padding: 10px 18px; font-size: 0.85rem; font-weight: 600;">Apply</button>
          </div>
          <div id="kmDiscountMsg" style="display: none; font-size: 0.8rem; margin-top: -16px; margin-bottom: 18px; font-weight: 600;"></div>

          <!-- Totals Breakdown -->
          <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.92rem; color: var(--km-text-secondary); margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between;">
              <span>Subtotal</span>
              <span id="kmSubtotalPrice" style="font-weight: 600; color: var(--km-text-primary);">₹0</span>
            </div>
            <div id="kmDiscountRow" style="display: none; justify-content: space-between; color: #16a34a;">
              <span>Royal Patron Discount (10%)</span>
              <span id="kmDiscountVal">-₹0</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span>Insured Heritage Shipping</span>
              <span style="color: #16a34a; font-weight: 700;">FREE (Pan-India)</span>
            </div>
            <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--km-border-subtle, #E5E7EB); padding-top: 14px; margin-top: 4px; font-size: 1.2rem; font-weight: 700; color: var(--km-text-primary);">
              <span>Grand Total</span>
              <span id="kmGrandTotalPrice" style="color: var(--km-gold-dark, #C5A059);">₹0</span>
            </div>
          </div>

          <!-- Guarantee Badge List -->
          <div style="background: var(--km-bg-secondary, #F4EFE6); border-radius: 10px; padding: 16px; font-size: 0.8rem; line-height: 1.6; color: var(--km-text-secondary); display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span>🛡️</span>
              <span><strong>Lineage Guarantee:</strong> Handcrafted in Amritsar, Punjab</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span>📦</span>
              <span><strong>Discreet Packaging:</strong> Sealed in velvet &amp; padded crate</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span>📞</span>
              <span><strong>patron Support:</strong> WhatsApp +91-75084-27731</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<style>
  @media (max-width: 860px) {
    #kmCheckoutGrid {
      grid-template-columns: 1fr !important;
    }
    .km-checkout-summary-col {
      order: -1;
    }
  }
</style>

<script>
  (function() {
    function getStoredCart() {
      try {
        var raw = localStorage.getItem('kraftmart_cart_v2') || localStorage.getItem('kraftmart_cart');
        return raw ? JSON.parse(raw) : [];
      } catch(e) {
        return [];
      }
    }

    function formatINR(num) {
      return '₹' + Number(num || 0).toLocaleString('en-IN');
    }

    var items = getStoredCart();
    var discountPercent = 0;

    var emptyEl = document.getElementById('kmCheckoutEmpty');
    var gridEl = document.getElementById('kmCheckoutGrid');
    var itemsContainer = document.getElementById('kmSummaryItems');
    var countEl = document.getElementById('kmSummaryCount');
    var subtotalEl = document.getElementById('kmSubtotalPrice');
    var totalEl = document.getElementById('kmGrandTotalPrice');
    var discountRow = document.getElementById('kmDiscountRow');
    var discountVal = document.getElementById('kmDiscountVal');
    var discountInput = document.getElementById('kmDiscountInput');
    var discountBtn = document.getElementById('kmApplyDiscountBtn');
    var discountMsg = document.getElementById('kmDiscountMsg');
    var formEl = document.getElementById('kmCheckoutForm');
    var successCard = document.getElementById('kmOrderSuccessCard');
    var placeOrderBtn = document.getElementById('kmPlaceOrderBtn');

    if (!items || !items.length) {
      if (emptyEl) emptyEl.style.display = 'block';
      if (gridEl) gridEl.style.display = 'none';
      return;
    }

    function renderSummary() {
      if (!itemsContainer) return;
      itemsContainer.innerHTML = '';
      var subtotal = 0;
      var count = 0;

      items.forEach(function(item) {
        var lineTotal = (item.price || 0) * (item.qty || 1);
        subtotal += lineTotal;
        count += (item.qty || 1);

        var row = document.createElement('div');
        row.style.cssText = 'display: flex; gap: 14px; align-items: center;';
        row.innerHTML = 
          '<div style="position: relative; width: 56px; height: 56px; flex-shrink: 0; border-radius: 8px; border: 1px solid rgba(197,160,89,0.3); overflow: hidden; background: #FFF;">' +
            '<img src="' + (item.image || '/assets/jaipur_wedding_talwar.png') + '" alt="' + (item.title || 'Product') + '" style="width: 100%; height: 100%; object-fit: contain;" />' +
            '<span style="position: absolute; top: -4px; right: -4px; background: var(--km-gold-dark, #C5A059); color: #FFF; font-size: 0.7rem; font-weight: 700; width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">' + (item.qty || 1) + '</span>' +
          '</div>' +
          '<div style="flex-grow: 1; min-width: 0;">' +
            '<div style="font-weight: 600; font-size: 0.88rem; color: var(--km-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">' + (item.title || 'Product') + '</div>' +
            (item.variant ? '<div style="font-size: 0.75rem; color: var(--km-text-secondary);">' + item.variant + '</div>' : '') +
          '</div>' +
          '<div style="font-weight: 700; font-size: 0.95rem; color: var(--km-gold-dark, #C5A059);">' + formatINR(lineTotal) + '</div>';
        itemsContainer.appendChild(row);
      });

      if (countEl) countEl.textContent = count;
      if (subtotalEl) subtotalEl.textContent = formatINR(subtotal);

      var discountAmount = Math.round(subtotal * discountPercent);
      if (discountPercent > 0) {
        if (discountRow) discountRow.style.display = 'flex';
        if (discountVal) discountVal.textContent = '-' + formatINR(discountAmount);
      } else {
        if (discountRow) discountRow.style.display = 'none';
      }

      var grandTotal = Math.max(0, subtotal - discountAmount);
      if (totalEl) totalEl.textContent = formatINR(grandTotal);
    }

    renderSummary();

    // Discount coupon application
    if (discountBtn && discountInput) {
      discountBtn.addEventListener('click', function() {
        var code = (discountInput.value || '').trim().toUpperCase();
        if (code === 'ROYAL10' || code === 'HERITAGE' || code === 'GROOM10' || code === 'KRAFTMART') {
          discountPercent = 0.10;
          renderSummary();
          if (discountMsg) {
            discountMsg.style.display = 'block';
            discountMsg.style.color = '#16a34a';
            discountMsg.textContent = '✓ 10% Royal Patron discount applied!';
          }
        } else if (code) {
          discountPercent = 0;
          renderSummary();
          if (discountMsg) {
            discountMsg.style.display = 'block';
            discountMsg.style.color = '#dc2626';
            discountMsg.textContent = 'Invalid code. Try "ROYAL10" for 10% off.';
          }
        }
      });
    }

    // Handle Form Submit
    if (formEl) {
      formEl.addEventListener('submit', function(e) {
        e.preventDefault();
        if (!formEl.checkValidity()) {
          formEl.reportValidity();
          return;
        }

        if (placeOrderBtn) {
          placeOrderBtn.disabled = true;
          placeOrderBtn.textContent = 'Securing order with Amritsar Forge…';
        }

        setTimeout(function() {
          var fname = (document.getElementById('kmFirstName') || {}).value || 'Patron';
          var lname = (document.getElementById('kmLastName') || {}).value || '';
          var email = (document.getElementById('kmEmail') || {}).value || '';
          var phone = (document.getElementById('kmPhone') || {}).value || '';
          var addr = (document.getElementById('kmAddress1') || {}).value || '';
          var city = (document.getElementById('kmCity') || {}).value || '';
          var state = (document.getElementById('kmState') || {}).value || '';
          var pin = (document.getElementById('kmPincode') || {}).value || '';
          var payRadio = document.querySelector('input[name="payment_method"]:checked');
          var payMode = payRadio ? (payRadio.value === 'COD' ? 'Cash on Delivery (COD)' : (payRadio.value === 'UPI' ? 'UPI (Google Pay/PhonePe)' : 'Card/NetBanking')) : 'COD';

          var orderNum = '#KM-2026-' + Math.floor(1000 + Math.random() * 9000);

          if (document.getElementById('kmConfOrderNo')) document.getElementById('kmConfOrderNo').textContent = orderNum;
          if (document.getElementById('kmConfName')) document.getElementById('kmConfName').textContent = fname + ' ' + lname;
          if (document.getElementById('kmConfContact')) document.getElementById('kmConfContact').textContent = phone + ' (' + email + ')';
          if (document.getElementById('kmConfAddress')) document.getElementById('kmConfAddress').textContent = addr + ', ' + city + ', ' + state + ' - ' + pin;
          if (document.getElementById('kmConfPayment')) document.getElementById('kmConfPayment').textContent = payMode;

          // Clear local storage cart
          try {
            localStorage.removeItem('kraftmart_cart_v2');
            localStorage.removeItem('kraftmart_cart');
          } catch(e) {}
          if (window.KMCart && window.KMCart.clear) window.KMCart.clear();

          formEl.style.display = 'none';
          if (successCard) {
            successCard.style.display = 'block';
            successCard.scrollIntoView({ behavior: 'smooth' });
          }
        }, 900);
      });
    }

  })();
</script>

