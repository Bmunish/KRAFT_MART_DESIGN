<!-- Heritage Craft Numbers Strip & Trust Ribbon -->
<section class="km-section"
  style="padding: 56px 0; background: var(--km-bg-secondary); border-top: var(--km-border-gold); border-bottom: var(--km-border-gold);">
  <div class="km-container">
    <div class="km-stats-grid">
      <div class="km-stat-item">
        <div class="km-stat-number">{{ section.settings.stat_1_num | default: "30" }}<span>{{ section.settings.stat_1_suffix | default: "+" }}</span></div>
        <div class="km-stat-label">{{ section.settings.stat_1_label | default: "Years of Legacy" }}</div>
        <div class="km-stat-sub">{{ section.settings.stat_1_sub | default: "Amritsar · Since 1996" }}</div>
      </div>
      <div class="km-stat-divider"></div>
      <div class="km-stat-item">
        <div class="km-stat-number">{{ section.settings.stat_2_num | default: "10K" }}<span>{{ section.settings.stat_2_suffix | default: "+" }}</span></div>
        <div class="km-stat-label">{{ section.settings.stat_2_label | default: "Blades Handcrafted" }}</div>
        <div class="km-stat-sub">{{ section.settings.stat_2_sub | default: "Talwars · Kirpans · Ceremonials" }}</div>
      </div>
      <div class="km-stat-divider"></div>
      <div class="km-stat-item">
        <div class="km-stat-number">{{ section.settings.stat_3_num | default: "42" }}<span>{{ section.settings.stat_3_suffix | default: "+" }}</span></div>
        <div class="km-stat-label">{{ section.settings.stat_3_label | default: "Countries Served" }}</div>
        <div class="km-stat-sub">{{ section.settings.stat_3_sub | default: "Trusted global delivery" }}</div>
      </div>
      <div class="km-stat-divider"></div>
      <div class="km-stat-item">
        <div class="km-stat-number">{{ section.settings.stat_4_num | default: "4.9" }}<span>{{ section.settings.stat_4_suffix | default: "★" }}</span></div>
        <div class="km-stat-label">{{ section.settings.stat_4_label | default: "Verified Rating" }}</div>
        <div class="km-stat-sub">{{ section.settings.stat_4_sub | default: "10,000+ happy buyers" }}</div>
      </div>
    </div>

    <div class="km-heritage-ribbon" aria-label="KraftMart trust highlights">
      <div class="km-ribbon-glow" aria-hidden="true"></div>
      <div class="km-ribbon-item">
        <span class="km-ribbon-kicker">{{ section.settings.ribbon_1_kicker | default: "Royal Wedding Ready" }}</span>
        <p>{{ section.settings.ribbon_1_text | default: "Personalized engraving included" }}</p>
      </div>
      <div class="km-ribbon-item">
        <span class="km-ribbon-kicker">{{ section.settings.ribbon_2_kicker | default: "Museum-grade Craft" }}</span>
        <p>{{ section.settings.ribbon_2_text | default: "Forged with ceremonial balance" }}</p>
      </div>
      <div class="km-ribbon-item">
        <span class="km-ribbon-kicker">{{ section.settings.ribbon_3_kicker | default: "Secure Shipping" }}</span>
        <p>{{ section.settings.ribbon_3_text | default: "FedEx and DHL insured worldwide" }}</p>
      </div>
    </div>
  </div>
</section>

