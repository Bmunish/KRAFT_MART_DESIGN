<!-- Heritage Craft Numbers Strip (replaces dark Masterpiece section) -->
  <section class="km-section"
    style="padding: 56px 0; background: var(--km-bg-secondary); border-top: var(--km-border-gold); border-bottom: var(--km-border-gold);">
    <div class="km-container">
      <div class="km-stats-grid">
        <div class="km-stat-item">
          <div class="km-stat-number">30<span>+</span></div>
          <div class="km-stat-label">Years of Legacy</div>
          <div class="km-stat-sub">Amritsar · Since 1996</div>
        </div>
        <div class="km-stat-divider"></div>
        <div class="km-stat-item">
          <div class="km-stat-number">10K<span>+</span></div>
          <div class="km-stat-label">Blades Handcrafted</div>
          <div class="km-stat-sub">Talwars · Kirpans · Ceremonials</div>
        </div>
        <div class="km-stat-divider"></div>
        <div class="km-stat-item">
          <div class="km-stat-number">42<span>+</span></div>
          <div class="km-stat-label">Countries Served</div>
          <div class="km-stat-sub">Trusted global delivery</div>
        </div>
        <div class="km-stat-divider"></div>
        <div class="km-stat-item">
          <div class="km-stat-number">4.9<span>★</span></div>
          <div class="km-stat-label">Verified Rating</div>
          <div class="km-stat-sub">10,000+ happy buyers</div>
        </div>
      </div>

      <div class="km-heritage-ribbon" aria-label="KraftMart trust highlights">
        <div class="km-ribbon-glow" aria-hidden="true"></div>
        <div class="km-ribbon-item">
          <span class="km-ribbon-kicker">Royal Wedding Ready</span>
          <p>Personalized engraving included</p>
        </div>
        <div class="km-ribbon-item">
          <span class="km-ribbon-kicker">Museum-grade Craft</span>
          <p>Forged with ceremonial balance</p>
        </div>
        <div class="km-ribbon-item">
          <span class="km-ribbon-kicker">Secure Shipping</span>
          <p>FedEx and DHL insured worldwide</p>
        </div>
      </div>
    </div>
  </section>


