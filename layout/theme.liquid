<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title | default: 'KraftMart | Luxury Indian Heritage Swords' }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  <meta name="description"
    content="{{ page_description | default: 'Buy authentic Indian wedding swords, Rajput talwars, Punjabi khandas & ceremonial swords online at KraftMart. Handcrafted in Amritsar, Punjab. Free custom engraving.' | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="stylesheet" href="{{ 'kraftmart-heritage.css' | asset_url }}">
  <style>
    /* Strictly remove ABCD and color swatches on homepage */
    .km-swatch-container,
    .km-variant-swatches,
    .km-color-swatches {
      display: none !important;
    }
  </style>
  <script src="{{ 'kraftmart-heritage.js' | asset_url }}" defer></script>
  <script src="{{ 'km-cart.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body>
  {% section 'header' %}
  
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
  
  {% section 'footer' %}
  
  {% render 'overlays' %}

  
</body>
</html>
