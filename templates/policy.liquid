<!-- KraftMart Official Policy Template -->
<section class="km-section" style="padding: 64px 0 80px; background: var(--km-bg-main, #fcfbf9);">
  <div class="km-container">
    <div style="max-width: 960px; margin: 0 auto; background: #FFFFFF; border: 1px solid rgba(197, 160, 89, 0.28); border-radius: 18px; box-shadow: 0 16px 48px rgba(20, 18, 16, 0.05); padding: 48px 44px; position: relative;">
      
      <!-- Policy Nav Tabs -->
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 36px; padding-bottom: 24px; border-bottom: 1px solid rgba(197, 160, 89, 0.2);">
        {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">🚚 Shipping Policy</a>{% else %}<a href="/policies/shipping-policy" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">🚚 Shipping Policy</a>{% endif %}
        <a href="/policies/processing-time" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">⏱️ Processing Time</a>
        {% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">↩ Returns &amp; Refund</a>{% else %}<a href="/policies/refund-policy" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">↩ Returns &amp; Refund</a>{% endif %}
        {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">🔒 Privacy Policy</a>{% else %}<a href="/policies/privacy-policy" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">🔒 Privacy Policy</a>{% endif %}
        {% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">📜 Terms of Service</a>{% else %}<a href="/policies/terms-of-service" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">📜 Terms of Service</a>{% endif %}
        <a href="/pages/contact" class="km-tab-btn" style="padding: 8px 18px; border-radius: 20px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(197,160,89,0.3); color: var(--km-text-primary);">✉ Contact Support</a>
      </div>

      <!-- Feature Highlight Badges -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 36px;">
        <div style="background: rgba(197,160,89,0.06); border: 1px solid rgba(197,160,89,0.22); border-radius: 12px; padding: 18px; display: flex; gap: 14px; align-items: center;">
          <span style="font-size: 1.8rem;">🚚</span>
          <div>
            <strong style="display: block; font-size: 0.92rem; color: var(--km-text-primary); margin-bottom: 2px;">Pan-India Delivery</strong>
            <span style="font-size: 0.78rem; color: var(--km-text-secondary);">Delhivery / DTDC (8–10 Days)</span>
          </div>
        </div>
        <div style="background: rgba(197,160,89,0.06); border: 1px solid rgba(197,160,89,0.22); border-radius: 12px; padding: 18px; display: flex; gap: 14px; align-items: center;">
          <span style="font-size: 1.8rem;">✈️</span>
          <div>
            <strong style="display: block; font-size: 0.92rem; color: var(--km-text-primary); margin-bottom: 2px;">FedEx &amp; DHL Worldwide</strong>
            <span style="font-size: 0.78rem; color: var(--km-text-secondary);">Direct dispatch (7–8 Days)</span>
          </div>
        </div>
        <div style="background: rgba(197,160,89,0.06); border: 1px solid rgba(197,160,89,0.22); border-radius: 12px; padding: 18px; display: flex; gap: 14px; align-items: center;">
          <span style="font-size: 1.8rem;">🛡️</span>
          <div>
            <strong style="display: block; font-size: 0.92rem; color: var(--km-text-primary); margin-bottom: 2px;">Verified Craftsmanship</strong>
            <span style="font-size: 0.78rem; color: var(--km-text-secondary);">Lakshmi Engineering Works (1996)</span>
          </div>
        </div>
      </div>

      <span class="km-eyebrow" style="color: var(--km-gold); letter-spacing: 0.15em; font-size: 0.78rem; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 8px;">KraftMart Customer Care</span>
      <h1 class="km-heading-1" style="font-family: var(--km-font-heading); font-size: clamp(1.8rem, 3vw, 2.5rem); margin: 0 0 24px; color: var(--km-text-primary);">
        {{ policy.title | default: "Store Policy &amp; Terms" }}
      </h1>

      <div class="km-page-content" style="line-height: 1.85; color: var(--km-text-secondary, #3b332b); font-size: 0.95rem;">
        {% if policy.body != blank %}
          {{ policy.body }}
        {% else %}
          <!-- Default Fallback Policy Information -->
          <div style="padding: 24px; background: rgba(0,0,0,0.02); border-radius: 12px; border-left: 4px solid var(--km-gold);">
            <h3 style="font-family: var(--km-font-heading); margin-top: 0; color: var(--km-text-primary);">KraftMart Heritage &bull; Official Policy Notice</h3>
            <p>At KraftMart (Lakshmi Engineering Works, Est. 1996, Amritsar, Punjab), each artifact, ceremonial talwar, kirpan, and traditional handicraft is individually inspected and securely packed prior to dispatch.</p>
            
            <h4 style="margin: 20px 0 8px; color: var(--km-text-primary);">Shipping &amp; Transit Times</h4>
            <ul style="padding-left: 20px;">
              <li><strong>Domestic Orders (India):</strong> 8–10 business days via Delhivery, DTDC, and India Post.</li>
              <li><strong>International Orders:</strong> 7–8 business days worldwide express delivery via FedEx &amp; DHL.</li>
              <li><strong>Laser Engraving Orders:</strong> Please allow 1–2 business days for bespoke blade name engraving.</li>
            </ul>

            <h4 style="margin: 20px 0 8px; color: var(--km-text-primary);">Cancellations &amp; Returns</h4>
            <p>Due to the bespoke nature of personalized and ceremonial artifacts, orders customized with personal name engraving cannot be returned unless damaged during transit. For transit damage claims, please contact our helpline within 48 hours of delivery with photographic evidence.</p>

            <h4 style="margin: 20px 0 8px; color: var(--km-text-primary);">Contact Helpline</h4>
            <p>Telephone: <strong>+91-75084-27731</strong> | Email: <strong>support@kraftmart.shop</strong><br>
            Workshop: G.T. Road, Putligarh, Amritsar, Punjab 143001, India.</p>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>
