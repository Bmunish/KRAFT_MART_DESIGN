{% comment %}
  KRAFTMART — LUXURY PRODUCT DETAIL PAGE (PDP) TEMPLATE
{% endcomment %}

<section class="km-section">
  <div class="km-container">
    <div style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: start;">
      <!-- Product Gallery -->
      <div>
        <div style="background: #FFF; border-radius: var(--km-radius-md); border: var(--km-border-gold); padding: 32px; text-align: center; margin-bottom: 16px;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" style="max-height: 500px; margin: 0 auto; object-fit: contain;" />
          {% else %}
            <img src="{{ 'sword2.png' | asset_url }}" alt="{{ product.title | default: 'KraftMart Talwar' }}" style="max-height: 500px; margin: 0 auto; object-fit: contain;" />
          {% endif %}
        </div>
      </div>

      <!-- Product Purchase Form & Information -->
      <div>
        <span class="km-eyebrow">{{ product.vendor | default: "Handcrafted in Amritsar" }}</span>
        <h1 class="km-heading-2" style="margin-bottom: 12px;">{{ product.title | default: "Royal Jodhpur Damascus Talwar" }}</h1>

        <div class="km-price-wrapper" style="justify-content: flex-start; margin-bottom: 20px;">
          <span class="km-price-current" style="font-size: 1.6rem;">{{ product.price | money | default: "₹4,299" }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="km-price-compare" style="font-size: 1.1rem;">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>

        <form method="post" action="/cart/add" style="margin-bottom: 32px;">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />

          <!-- Custom Engraving Input -->
          <div style="background-color: var(--km-bg-secondary); padding: 20px; border-radius: var(--km-radius-sm); border: var(--km-border-gold); margin-bottom: 24px;">
            <label style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 8px; color: var(--km-text-primary);">
              ✒️ Free Custom Laser Engraving Inscription:
            </label>
            <input type="text" name="properties[Engraving Inscription]" placeholder="e.g. Gurpreet & Simran • 14.02.2026" style="width: 100%; background: #FFF; border: var(--km-border-subtle); padding: 12px; border-radius: var(--km-radius-sm); font-size: 0.875rem;" />
            <span style="font-size: 0.75rem; color: var(--km-text-secondary); margin-top: 6px; display: block;">
              Leave blank if no engraving is required.
            </span>
          </div>

          <div style="display: flex; gap: 16px;">
            <button type="submit" class="km-btn km-btn-gold" style="flex: 1;">
              Add to Cart →
            </button>
            <button type="submit" name="checkout" class="km-btn km-btn-primary" style="flex: 1;">
              Buy Now
            </button>
          </div>
        </form>

        <!-- Trust Badges -->
        <div style="border-top: var(--km-border-subtle); padding-top: 24px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; font-size: 0.8125rem; color: var(--km-text-secondary);">
          <div>✓ COD Available (15% Advance)</div>
          <div>✓ Express FedEx / DHL Shipping</div>
          <div>✓ Authentic Velvet Scabbard</div>
          <div>✓ Hand-polished Brass Hilt</div>
        </div>
      </div>
    </div>
  </div>
</section>
