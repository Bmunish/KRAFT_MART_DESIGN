{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money_without_trailing_zeros | escape }}</title>
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  <link rel="stylesheet" href="{{ 'kraftmart-heritage.css' | asset_url }}">
</head>
<body style="background:#0a0a0a;color:#d4af37;font-family:serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:2rem;box-sizing:border-box;">
  <div style="max-width:480px;width:100%;text-align:center;border:1px solid #d4af37;padding:3rem 2rem;background:#111;">
    <h1 style="font-size:1.2rem;letter-spacing:.2em;text-transform:uppercase;margin:0 0 1.5rem;">KraftMart Gift Card</h1>
    <p style="font-size:3rem;font-weight:bold;margin:0 0 0.5rem;">{{ gift_card.initial_value | money_without_trailing_zeros }}</p>
    {% if gift_card.enabled == false or gift_card.expired %}
      <p style="color:#e74c3c;margin:0 0 1.5rem;">{{ 'gift_cards.issued.expired' | t }}</p>
    {% else %}
      <p style="opacity:.7;font-size:.85rem;margin:0 0 1.5rem;">
        {% if gift_card.expires_on %}
          {{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card.expires_on | date: '%B %d, %Y' }}
        {% else %}
          {{ 'gift_cards.issued.no_expiry' | t }}
        {% endif %}
      </p>
    {% endif %}
    <div style="background:#000;padding:1.5rem;margin:1.5rem 0;display:flex;justify-content:center;">
      <div class="gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
    </div>
    <p style="letter-spacing:.3em;font-size:1.1rem;margin:0 0 1.5rem;">{{ gift_card.code | format_code }}</p>
    <p style="opacity:.7;font-size:.85rem;">
      {{ 'gift_cards.issued.balance' | t: balance: gift_card.balance | money }}
    </p>
    <a href="{{ shop.url }}" style="display:inline-block;margin-top:2rem;padding:.75rem 2rem;background:#d4af37;color:#000;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;font-size:.85rem;">
      {{ 'gift_cards.issued.shop_link' | t }}
    </a>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var qrEl = document.querySelector('.gift-card__qr-code');
      if (qrEl && window.QRCode) {
        new QRCode(qrEl, {
          text: qrEl.dataset.identifier,
          width: 120,
          height: 120
        });
      }
    });
  </script>
</body>
</html>
